{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Npgsql": "Warning",
        "Quartz": "Warning",
        "OpenTelemetry": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AppLogging": {
    "Request": {
      "SlowRequestThresholdMs": 1000,
      "LogReadSuccessAsDebug": true,
      "ExcludedPathPrefixes": [
        "/health",
        "/docs",
        "/openapi",
        "/swagger",
        "/hubs"
      ]
    },
    "Jobs": {
      "SlowJobThresholdMs": 2000,
      "LogNoopRuns": false
    },
    "MediatR": {
      "SlowRequestThresholdMs": 500,
      "LogSuccessfulQueriesAtDebug": true
    }
  },
  "App": {
    "AppName": "OIO Auction",
    "Version": "1.0.0",
    "FeUrl": "http://localhost:3000",
    "BeUrl": "http://localhost:5000",
    "EmailVerifyPath": "/auth/confirm-email",
    "ResetPasswordPath": "/auth/reset-password"
  },
  "Features": {
    "EnableScalar": true
  },
  "Auction": {
    "MaxExtensionsPerAuction": 10,
    "ExtensionThreshold": "00:05:00",
    "MaxDuration": "30.00:00:00",
    "MinDuration": "01:00:00",
    "RunnerUpOfferExpirationHours": 24
  },
  "Item": {
    "MaxQuestionsPerItem": 100
  },
  "Ai": {
    "ProductDescription": {
      "Enabled": true,
      "Provider": "Google",
      "Model": "gemini-3-flash-preview",
      "TimeoutSeconds": 30,
      "MaxImages": 3,
      "MaxDescriptionChars": 5000,
      "Temperature": 0.4,
      "MinSuggestedConfidence": 0.4,
      "MinAlternativeConfidence": 0.2,
      "RateLimitPerMinutePerSeller": 5
    }
  },
