@using OIO.Infrastructure.Mail.RazorEmails.Rendering.ViewModels

<LayoutView Layout="@typeof(MainLayout)">
    <div style="color:#111827;">
        <h1 style="margin:0 0 12px; font-size:22px; line-height:1.3; font-weight:700; color:#111827;">
            Your Password Was Changed
        </h1>

        <p style="margin:0 0 16px; font-size:14px; line-height:1.6; color:#374151;">
            Dear @Model.UserName,
        </p>

        <p style="margin:0 0 16px; font-size:14px; line-height:1.6; color:#374151;">
            Your password was successfully changed.
        </p>

        <div style="margin:0 0 20px; padding:16px; background:#f9fafb; border:1px solid #e5e7eb; border-radius:10px;">
            <table style="width:100%; font-size:14px; color:#374151; border-collapse:collapse;">
                <tr>
                    <td style="padding:4px 0; font-weight:600; width:120px;">Changed at:</td>
                    <td style="padding:4px 0;">@Model.ChangedAt.ToString("dddd, dd MMMM yyyy hh:mm tt")</td>
                </tr>
            </table>
        </div>

        <div style="margin:0 0 20px; padding:14px 16px; background:#fef2f2; border:1px solid #fecaca; border-radius:10px;">
            <p style="margin:0; font-size:13px; line-height:1.6; color:#991b1b;">
                🔒 <strong>Wasn't you?</strong> Your account may be compromised. 
                Please take these steps immediately:
            </p>
            <ol style="margin:8px 0 0; padding-left:20px; font-size:13px; line-height:1.8; color:#991b1b;">
                <li>Reset your password using the "Forgot Password" page</li>
                <li>Enable two-factor authentication</li>
                <li>Review your active sessions and revoke any suspicious ones</li>
            </ol>
        </div>

        <p style="margin:0 0 16px; font-size:14px; line-height:1.6; color:#374151;">
            If you made this change, no further action is needed.
        </p>

        <p style="margin:0; font-size:14px; line-height:1.6; color:#374151;">
            Best regards,<br/>
            The OIO Team
        </p>
    </div>
</LayoutView>

@code {
    [Parameter]
    public PasswordChangedAlertMailViewModel Model { get; set; } = null!;
    
}