@using OIO.Infrastructure.Mail.RazorEmails.Rendering.ViewModels

<LayoutView Layout="@typeof(MainLayout)">
    <h2 style="margin:0 0 16px; font-size:24px; line-height:1.3; font-weight:700; color:#111827;">
        You’ve been outbid!
    </h2>

    <p style="margin:0 0 12px; font-size:14px; line-height:1.7; color:#374151;">
        Hello <strong style="color:#111827;">@Model.UserName</strong>,
    </p>

    <p style="margin:0 0 20px; font-size:14px; line-height:1.7; color:#374151;">
        Another bidder has placed a higher bid on the following auction:
    </p>

    <table style="width:100%; border-collapse:separate; border-spacing:0; margin:0 0 24px; background:#f9fafb; border:1px solid #e5e7eb; border-radius:12px; overflow:hidden;">
        <tr>
            <td style="padding:14px 16px; font-size:14px; color:#6b7280; border-bottom:1px solid #e5e7eb; width:42%;">
                Item
            </td>
            <td style="padding:14px 16px; font-size:14px; font-weight:600; color:#111827; border-bottom:1px solid #e5e7eb;">
                @Model.AuctionTitle
            </td>
        </tr>
        <tr>
            <td style="padding:14px 16px; font-size:14px; color:#6b7280;">
                Current highest bid
            </td>
            <td style="padding:14px 16px; font-size:14px; font-weight:700; color:#111827;">
                @Model.NewHighestBid.ToString("N0") @Model.Currency
            </td>
        </tr>
    </table>

    <a href="@Model.AuctionUrl"
       style="display:inline-block; padding:12px 24px; background:#111827; color:#ffffff; text-decoration:none; border-radius:10px; font-size:14px; font-weight:600;">
        Place a bid now
    </a>
</LayoutView>

@code {
    [Parameter]
    public OutbidMailViewModel Model { get; set; } = null!;
}
