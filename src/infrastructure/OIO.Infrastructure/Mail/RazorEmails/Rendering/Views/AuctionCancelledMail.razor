@using OIO.Infrastructure.Mail.RazorEmails.Rendering.ViewModels

<LayoutView Layout="@typeof(MainLayout)">
    <h2 style="margin:0 0 16px; font-size:24px; line-height:1.3; font-weight:700; color:#111827;">
        The auction has been cancelled
    </h2>

    <p style="margin:0 0 12px; font-size:15px; line-height:1.7; color:#111827;">
        Hello <strong>@Model.UserName</strong>,
    </p>

    <p style="margin:0 0 16px; font-size:15px; line-height:1.7; color:#374151;">
        The auction <strong>@Model.AuctionTitle</strong> has been cancelled.
    </p>

    <p style="margin:0 0 16px; font-size:15px; line-height:1.7; color:#374151;">
        Reason: <strong style="color:#111827;">@Model.Reason</strong>
    </p>

    <p style="margin:0; color:#6b7280; font-size:14px; line-height:1.7;">
        If you have already placed a deposit, the amount will be refunded to your wallet.
    </p>
</LayoutView>

@code {
    [Parameter]
    public AuctionCancelledMailViewModel Model { get; set; } 
}