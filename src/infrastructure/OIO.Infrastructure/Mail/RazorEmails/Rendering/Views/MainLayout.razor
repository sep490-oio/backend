@inherits OIO.Infrastructure.Mail.RazorEmails.Rendering.ViewModels.MainLayoutBase

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@AppName</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f5f7; font-family:'Segoe UI',Arial,Helvetica,sans-serif; -webkit-font-smoothing:antialiased;">
    <!--[if mso]>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td align="center">
    <![endif]-->

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f5f7;">
        <tr>
            <td align="center" style="padding:32px 16px;">
                <!-- Container -->
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:12px; overflow:hidden; box-shadow:0 4px 16px rgba(0,0,0,0.06);">

                    <!-- Header -->
                    <tr>
                        <td style="padding:24px 32px; background:linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); text-align:center;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center">
                                        <span style="font-size:28px; font-weight:800; color:#ffffff; letter-spacing:3px; font-family:Georgia,'Times New Roman',serif;">OIO</span>
                                        <br/>
                                        <span style="font-size:11px; color:rgba(255,255,255,0.6); letter-spacing:1px; text-transform:uppercase;">Online Auction Platform</span>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Accent bar -->
                    <tr>
                        <td style="height:3px; background:linear-gradient(90deg, #8B7355 0%, #C4A265 50%, #8B7355 100%);"></td>
                    </tr>

                    <!-- Body -->
                    <tr>
                        <td style="padding:32px 32px 28px;">
                            @Body
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td style="padding:20px 32px; background-color:#f9fafb; border-top:1px solid #e5e7eb;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="font-size:12px; line-height:1.6; color:#9ca3af; text-align:center;">
                                        &copy; @CurrentYear <strong style="color:#6b7280;">OIO</strong> &mdash; Online Auction Platform
                                        <br/>
                                        <a href="@(BaseUrl)" style="color:#8B7355; text-decoration:none;">oio.vn</a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

                <!-- Sub-footer -->
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%;">
                    <tr>
                        <td style="padding:16px 0; text-align:center; font-size:11px; line-height:1.5; color:#9ca3af;">
                            This is an automated message, please do not reply.
                            <br/>
                            <a href="@(BaseUrl)/me/notification-preferences" style="color:#8B7355; text-decoration:underline;">Manage notification preferences</a>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <!--[if mso]>
    </td></tr></table>
    <![endif]-->
</body>
</html>