@using OIO.Infrastructure.Mail.RazorEmails.Rendering.ViewModels

<LayoutView Layout="@typeof(MainLayout)">
    <h2 style="margin:0 0 16px; font-size:24px; line-height:1.3; font-weight:700; color:#111827;">
        The auction ended unsuccessfully
    </h2>

    <p style="margin:0 0 12px; font-size:15px; line-height:1.7; color:#111827;">
        Hello <strong>@Model.UserName</strong>,
    </p>

    <p style="margin:0 0 20px; font-size:15px; line-height:1.7; color:#374151;">
        Your auction has ended, but there was no winning bidder:
    </p>

    <table style="width:100%; border-collapse:separate; border-spacing:0; margin:16px 0 24px; border:1px solid #e5e7eb; border-radius:12px; overflow:hidden; background:#f9fafb;">
        <tr>
            <td style="padding:12px 16px; color:#6b7280; font-size:14px; border-bottom:1px solid #e5e7eb; width:40%;">
                Auction ID
            </td>
            <td style="padding:12px 16px; font-weight:600; color:#111827; font-size:14px; border-bottom:1px solid #e5e7eb;">
                @Model.AuctionId
            </td>
        </tr>
        <tr>
            <td style="padding:12px 16px; color:#6b7280; font-size:14px; border-bottom:1px solid #e5e7eb; width:40%;">
                Reason
            </td>
            <td style="padding:12px 16px; font-weight:600; color:#b91c1c; font-size:14px; border-bottom:1px solid #e5e7eb;">
                @Model.Reason
            </td>
        </tr>
        <tr>
            <td style="padding:12px 16px; color:#6b7280; font-size:14px; border-bottom:1px solid #e5e7eb; width:40%;">
                Total Bids
            </td>
            <td style="padding:12px 16px; color:#111827; font-size:14px; border-bottom:1px solid #e5e7eb;">
                @Model.TotalBids
            </td>
        </tr>
        <tr>
            <td style="padding:12px 16px; color:#6b7280; font-size:14px; width:40%;">
                Highest Bid
            </td>
            <td style="padding:12px 16px; color:#111827; font-size:14px; font-weight:600;">
                @Model.FinalPrice.ToString("N0") @Model.Currency
            </td>
        </tr>
    </table>

    <p style="margin:0 0 24px; font-size:15px; line-height:1.7; color:#374151;">
        You can relist your item with a different price:
    </p>

    <a href="@Model.RelistUrl"
       style="display:inline-block; padding:12px 24px; background:#8B7355; color:#ffffff; text-decoration:none; border-radius:10px; font-weight:600; font-size:14px;">
        Relist Item
    </a>
</LayoutView>

@code {
    [Parameter]
    public AuctionFailedMailViewModel Model { get; set; }
}