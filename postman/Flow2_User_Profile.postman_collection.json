{
	"info": {
		"_postman_id": "f2a1b2c3-d4e5-6f78-9a0b-c1d2e3f4a5b6",
		"name": "Flow 2 – User Profile",
		"description": "Tests 17 User Profile endpoints organized in 4 folders: View & Update Profile, Phone Verification, Address Management, and Notification Preferences.\n\nRequires environment variables: baseUrl, accessToken (from Flow 1), addressId.\nUses collection variables: secondAddressId, phoneVerificationCode, mediaUploadId.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "secondAddressId",
			"value": ""
		},
		{
			"key": "phoneVerificationCode",
			"value": ""
		},
		{
			"key": "mediaUploadId",
			"value": ""
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Ensure accessToken is available",
					"if (!pm.environment.get('accessToken')) {",
					"    console.warn('accessToken not set. Run Flow 1 Login first.');",
					"}"
				]
			}
		}
	],
	"item": [
		{
			"name": "01 – View & Update Profile",
			"item": [
				{
					"name": "Get Current User",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"me"
							]
						},
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has id, email, userName, profile', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json).to.have.property('id');",
									"    pm.expect(json).to.have.property('email');",
									"    pm.expect(json).to.have.property('userName');",
									"    pm.expect(json).to.have.property('profile');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Get User Profile",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/me/profile",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"me",
								"profile"
