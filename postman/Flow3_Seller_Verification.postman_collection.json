{
	"info": {
		"_postman_id": "a3b4c5d6-e7f8-9012-3456-789abcdef012",
		"name": "Flow 3 – Seller Verification",
		"description": "Tests 40 endpoints for the Seller Verification flow organized in 7 folders: Create & Update Verification, Upload Documents, Submit & eKYC, Admin Verification Review, Seller Profile, Seller Admin Review, and Terms Acceptance.\n\nRequires environment variables: baseUrl, accessToken, adminAccessToken, verificationId, sellerId, cloudinaryCloudName.\nUses collection variables: verificationDocId, idFrontUploadId, idBackUploadId, selfieUploadId, cloudinaryApiKey, cloudinaryTimestamp, cloudinaryFolder, cloudinarySignature, cloudinaryPublicId, termDocumentId.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "verificationDocId", "value": "" },
		{ "key": "idFrontUploadId", "value": "" },
		{ "key": "idBackUploadId", "value": "" },
		{ "key": "selfieUploadId", "value": "" },
		{ "key": "cloudinaryApiKey", "value": "" },
		{ "key": "cloudinaryTimestamp", "value": "" },
		{ "key": "cloudinaryFolder", "value": "" },
		{ "key": "cloudinarySignature", "value": "" },
		{ "key": "cloudinaryPublicId", "value": "" },
		{ "key": "termDocumentId", "value": "" }
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{accessToken}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Ensure accessToken is available",
					"if (!pm.environment.get('accessToken')) {",
					"    console.warn('accessToken not set. Run Flow 1 Login first.');",
					"}"
				]
			}
		}
	],
	"item": [
		{
			"name": "01 – Create & Update Verification",
			"item": [
				{
					"name": "Create Verification",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"verificationType\": \"government_id\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/me/verifications",
							"host": ["{{baseUrl}}"],
							"path": ["api", "me", "verifications"]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Save verificationId', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json).to.have.property('id');",
									"    pm.environment.set('verificationId', json.id);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Update Verification Details",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fullName\": \"Nguyen Van A\",\n  \"dateOfBirth\": \"1990-01-15\",\n  \"gender\": \"male\",\n  \"idType\": \"national_id\",\n  \"idNumber\": \"079090012345\",\n  \"issuedDate\": \"2020-01-01\",\n  \"expiredDate\": \"2035-01-01\",\n  \"issuedPlace\": \"TP.HCM\",\n  \"fullAddress\": \"123 Le Loi, P. Ben Thanh\",\n  \"province\": \"Ho Chi Minh\",\n  \"district\": \"Quan 1\",\n  \"ward\": \"Ben Thanh\",\n  \"nationality\": \"Vietnamese\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/me/verifications/{{verificationId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "me", "verifications", "{{verificationId}}"]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Get Verification by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/me/verifications/{{verificationId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "me", "verifications", "{{verificationId}}"]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Status is pending', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json.status).to.eql('pending');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "List My Verifications",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/me/verifications",
							"host": ["{{baseUrl}}"],
							"path": ["api", "me", "verifications"]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response is an array', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json).to.be.an('array');",
									"});"
								]
							}
						}
					]
				}
			]
		},
