{
  "info": {
    "name": "Flow 07: Bidding",
    "description": "Complete bidding flow: place bids, auto-bid, sealed bids, watch/unwatch, admin bid management.\n\n**Actors**: Buyer1, Buyer2, Admin\n**Prerequisite**: Flow 06 (Auction published and active)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "buyer1Token", "value": "" },
    { "key": "buyer2Token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "auctionId", "value": "PASTE_AUCTION_ID_HERE" },
    { "key": "bidId", "value": "" },
    { "key": "sealedBidId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "0.1 Login as Buyer 1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"buyer1@example.com\",\n  \"password\": \"Test@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.accessToken) pm.collectionVariables.set('buyer1Token', res.accessToken);"] } }]
        },
        {
          "name": "0.2 Login as Buyer 2",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"buyer2@example.com\",\n  \"password\": \"Test@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.accessToken) pm.collectionVariables.set('buyer2Token', res.accessToken);"] } }]
        },
        {
          "name": "0.3 Login as Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"admin@example.com\",\n  \"password\": \"Test@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.accessToken) pm.collectionVariables.set('adminToken', res.accessToken);"] } }]
        }
      ]
    },
    {
      "name": "Bidding",
      "item": [
        {
          "name": "7.1 Place Bid (REST)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyer1Token}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/bids", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "bids"] },
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 50000000,\n  \"currency\": \"VND\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.id) pm.collectionVariables.set('bidId', res.id);", "pm.test('Bid placed', () => pm.response.to.have.status(201));"] } }]
        },
        {
          "name": "7.2 Get Auction Bids",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer1Token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/bids?pageNumber=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions", "{{auctionId}}", "bids"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Bids retrieved', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Auto-Bid",
      "item": [
        {
          "name": "7.3 Configure Auto-Bid",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyer1Token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/auto-bid", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "auto-bid"] },
            "body": { "mode": "raw", "raw": "{\n  \"maxAmount\": 100000000,\n  \"currency\": \"VND\",\n  \"incrementAmount\": 1000000\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auto-bid configured', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "7.4 Get My Auto-Bid",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer1Token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/auto-bid/my", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "auto-bid", "my"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auto-bid status retrieved', () => pm.response.to.have.status(200));", "const res = pm.response.json();", "console.log('Auto-bid status:', res.status);"] } }]
        },
        {
          "name": "7.5 Pause Auto-Bid",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer1Token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/auto-bid/pause", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "auto-bid", "pause"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auto-bid paused', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "7.6 Resume Auto-Bid",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer1Token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/auto-bid/resume", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "auto-bid", "resume"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auto-bid resumed', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Sealed Bids",
      "item": [
        {
          "name": "7.7 Submit Sealed Bid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyer2Token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/sealed-bids", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "sealed-bids"] },
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 95000000\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.id) pm.collectionVariables.set('sealedBidId', res.id);", "pm.test('Sealed bid submitted', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Watch",
      "item": [
        {
          "name": "7.8 Watch Auction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyer1Token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/watch", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "watch"] },
            "body": { "mode": "raw", "raw": "{\n  \"notifyOnBid\": true,\n  \"notifyOnEnd\": true\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Watching auction', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "7.9 Unwatch Auction",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer1Token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/watch", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "watch"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Unwatched auction', () => pm.response.to.have.status(204));"] } }]
        }
      ]
    },
    {
      "name": "My Activity",
      "item": [
        {
          "name": "7.10 Get My Bids",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer1Token}}" }],
            "url": { "raw": "{{baseUrl}}/api/me/bids", "host": ["{{baseUrl}}"], "path": ["api", "me", "bids"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('My bids retrieved', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "7.11 Get My Watchlist",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer1Token}}" }],
            "url": { "raw": "{{baseUrl}}/api/me/auctions/watch-list", "host": ["{{baseUrl}}"], "path": ["api", "me", "auctions", "watch-list"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Watchlist retrieved', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "7.12 (Admin) Reveal Sealed Bid",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/auctions/{{auctionId}}/sealed-bids/{{sealedBidId}}/reveal", "host": ["{{baseUrl}}"], "path": ["api", "admin", "auctions", "{{auctionId}}", "sealed-bids", "{{sealedBidId}}", "reveal"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Sealed bid revealed', () => pm.response.to.have.status(200));", "const res = pm.response.json();", "console.log('Revealed amount:', res.revealedAmount);"] } }]
        },
        {
          "name": "7.13 (Admin) Cancel Invalid Bid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/auctions/{{auctionId}}/bids/{{bidId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "admin", "auctions", "{{auctionId}}", "bids", "{{bidId}}", "cancel"] },
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Fraudulent bid detected\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Bid cancelled', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    }
  ]
}
