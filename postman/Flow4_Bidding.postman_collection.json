{
  "info": {
    "name": "Flow 4: Tham gia đấu giá (Bidding)",
    "description": "Luồng buyer tham gia đấu giá: duyệt auction, đặt cọc, bid, auto-bid, theo dõi.\n\n**Actors**: Buyer1, Buyer2\n**Prerequisite**: Flow 3 (Auction đang Active)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "buyer1Token", "value": "" },
    { "key": "buyer2Token", "value": "" },
    { "key": "auctionId", "value": "PASTE_AUCTION_ID_HERE" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "0.1 Login as Buyer 1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"buyer1@example.com\",\n  \"password\": \"Test@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.accessToken) pm.collectionVariables.set('buyer1Token', res.accessToken);"] } }]
        },
        {
          "name": "0.2 Login as Buyer 2",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"buyer2@example.com\",\n  \"password\": \"Test@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.accessToken) pm.collectionVariables.set('buyer2Token', res.accessToken);"] } }]
        }
      ]
    },
    {
      "name": "Browse & Watch",
      "item": [
        {
          "name": "4.1 List Active Auctions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auctions?status=Active&pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions"],
              "query": [
                { "key": "status", "value": "Active" },
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auctions listed', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "4.2 Get Auction Details",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auction details', () => pm.response.to.have.status(200));", "const res = pm.response.json();", "console.log('Current price:', res.pricing?.currentAmount);", "console.log('Next min bid:', res.pricing?.nextMinimumBid);"] } }]
        },
        {
          "name": "4.3 [Buyer1] Watch Auction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyer1Token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/watch", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "watch"] },
            "body": { "mode": "raw", "raw": "{\n  \"notifyOnBid\": true,\n  \"notifyOnEnd\": true\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Watching auction', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Deposit & Bidding",
      "item": [
        {
          "name": "4.4 [Buyer1] Create Deposit Payment URL",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyer1Token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/vnpay/create-url", "host": ["{{baseUrl}}"], "path": ["api", "payments", "vnpay", "create-url"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000000,\n  \"currency\": \"VND\",\n  \"purpose\": \"Deposit\",\n  \"description\": \"Đặt cọc tham gia đấu giá\",\n  \"auctionId\": \"{{auctionId}}\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "console.log('VNPay URL:', res.paymentUrl);", "pm.test('Payment URL created', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "4.5 [Buyer1] Place First Bid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyer1Token}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/bids", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "bids"] },
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 50000000,\n  \"currency\": \"VND\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Bid placed', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "4.6 [Buyer2] Place Higher Bid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyer2Token}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/bids", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "bids"] },
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 52000000,\n  \"currency\": \"VND\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Bid placed by Buyer2', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "4.7 [Buyer1] Configure Auto-Bid",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyer1Token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/auto-bid", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "auto-bid"] },
            "body": { "mode": "raw", "raw": "{\n  \"maxAmount\": 100000000,\n  \"currency\": \"VND\",\n  \"incrementAmount\": 1000000\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auto-bid configured', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "4.8 [Buyer1] Get My Auto-Bid Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer1Token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/auto-bid/my", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "auto-bid", "my"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auto-bid status retrieved', () => pm.response.to.have.status(200));", "const res = pm.response.json();", "console.log('Auto-bid status:', res.status);", "console.log('Budget remaining:', res.remaining);"] } }]
        },
        {
          "name": "4.9 [Buyer2] Place Another Bid (triggers auto-bid battle)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyer2Token}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/bids", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "bids"] },
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 55000000,\n  \"currency\": \"VND\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Bid triggers auto-bid battle', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Monitor",
      "item": [
        {
          "name": "4.10 Get Bid History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer1Token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/bids?pageNumber=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions", "{{auctionId}}", "bids"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Bids retrieved', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "4.11 [Buyer1] Get My Bids",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer1Token}}" }],
            "url": { "raw": "{{baseUrl}}/api/me/bids", "host": ["{{baseUrl}}"], "path": ["api", "me", "bids"] }
          }
        },
        {
          "name": "4.12 [Buyer1] Get Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer1Token}}" }],
            "url": { "raw": "{{baseUrl}}/api/notifications", "host": ["{{baseUrl}}"], "path": ["api", "notifications"] }
          }
        },
        {
          "name": "4.13 Get Unread Notification Count",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer1Token}}" }],
            "url": { "raw": "{{baseUrl}}/api/notifications/unread-count", "host": ["{{baseUrl}}"], "path": ["api", "notifications", "unread-count"] }
          }
        },
        {
          "name": "4.14 [Buyer1] Pause Auto-Bid",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer1Token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/auto-bid/pause", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "auto-bid", "pause"] }
          }
        },
        {
          "name": "4.15 [Buyer1] Resume Auto-Bid",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer1Token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/auto-bid/resume", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "auto-bid", "resume"] }
          }
        }
      ]
    }
  ]
}
