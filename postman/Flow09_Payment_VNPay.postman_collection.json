  "item": [
    {
      "name": "01-Create Payment URL",
      "item": [
        {
          "name": "1. Create URL — Auction Deposit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500000,\n  \"currency\": \"VND\",\n  \"purpose\": \"auction_deposit\",\n  \"description\": \"Deposit for auction\",\n  \"auctionId\": \"{{auctionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/vnpay/create-url",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "vnpay", "create-url"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 – payment URL created', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "if (body.transactionId) {",
                  "    pm.collectionVariables.set('transactionId', body.transactionId);",
                  "    console.log('transactionId saved:', body.transactionId);",
                  "}",
                  "if (body.transactionRef) {",
                  "    pm.collectionVariables.set('transactionRef', body.transactionRef);",
                  "    console.log('transactionRef saved:', body.transactionRef);",
                  "}",
                  "if (body.paymentUrl) {",
                  "    pm.collectionVariables.set('paymentUrl', body.paymentUrl);",
