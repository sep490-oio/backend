    {
      "name": "03-IPN & Return Callbacks",
      "item": [
        {
          "name": "9. [Info] IPN Endpoint",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/vnpay/ipn?vnp_TxnRef={{transactionRef}}&vnp_ResponseCode=00&vnp_TransactionNo=14000000&vnp_Amount=50000000&vnp_SecureHash=TEST_HASH",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "vnpay", "ipn"],
              "query": [
                { "key": "vnp_TxnRef", "value": "{{transactionRef}}" },
                { "key": "vnp_ResponseCode", "value": "00" },
                { "key": "vnp_TransactionNo", "value": "14000000" },
                { "key": "vnp_Amount", "value": "50000000" },
                { "key": "vnp_SecureHash", "value": "TEST_HASH" }
              ]
            },
            "description": "VNPay IPN callback (server-to-server). AllowAnonymous. VNPay calls this to notify payment result. Returns JSON with RspCode. In production, VNPay signs the query string — the TEST_HASH here is a placeholder."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 – IPN responded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('RspCode present', function () {",
                  "    pm.expect(body).to.have.property('RspCode');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "10. [Info] Return Endpoint",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/vnpay/return?vnp_TxnRef={{transactionRef}}&vnp_ResponseCode=00&vnp_TransactionNo=14000000&vnp_Amount=50000000&vnp_SecureHash=TEST_HASH",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "vnpay", "return"],
              "query": [
                { "key": "vnp_TxnRef", "value": "{{transactionRef}}" },
                { "key": "vnp_ResponseCode", "value": "00" },
                { "key": "vnp_TransactionNo", "value": "14000000" },
                { "key": "vnp_Amount", "value": "50000000" },
                { "key": "vnp_SecureHash", "value": "TEST_HASH" }
              ]
            },
            "description": "VNPay Return URL. AllowAnonymous. VNPay redirects user here after payment. Frontend uses this to display payment status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 – return processed', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "11. [Info] ProcessGatewayWebhooksJob",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments/methods",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "methods"]
            },
            "description": "INFO ONLY — ProcessGatewayWebhooksJob runs every 10s in background. It processes saved VNPay webhooks asynchronously: updates transaction status, creates escrows, marks orders paid, handles deposits, and creates payment methods from token callbacks. This request is a no-op placeholder — use Get Payment Methods to verify side-effects after IPN."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 – info placeholder', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
