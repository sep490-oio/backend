{
  "info": {
    "name": "Flow 09 — Payment & VNPay",
    "_postman_id": "flow09-payment-vnpay",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
