{
  "info": {
    "name": "Mailtrap: Lấy confirm_url từ email mới nhất",
    "description": "Lấy email mới nhất từ Mailtrap Testing API và parse ra confirm URL để tự động hoá flow xác nhận email.\n\n**Setup**:\n1. Vào https://mailtrap.io → Settings → API Tokens → Copy token\n2. Vào Email Testing → Inbox → Lấy `account_id` và `inbox_id` từ URL\n   VD: `https://mailtrap.io/inboxes/12345/messages` → inbox_id = 12345\n3. Account ID lấy từ: Settings → API Tokens → hoặc URL path",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "mailtrapToken", "value": "YOUR_MAILTRAP_API_TOKEN" },
    { "key": "accountId", "value": "YOUR_ACCOUNT_ID" },
    { "key": "inboxId", "value": "YOUR_INBOX_ID" },
    { "key": "messageId", "value": "" },
    { "key": "confirmUrl", "value": "" }
  ],
  "item": [
    {
      "name": "1. Get Latest Email & Extract Message ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Api-Token", "value": "{{mailtrapToken}}" }
        ],
        "url": {
          "raw": "https://mailtrap.io/api/accounts/{{accountId}}/inboxes/{{inboxId}}/messages?page=1&last_id=",
          "protocol": "https",
          "host": ["mailtrap", "io"],
          "path": ["api", "accounts", "{{accountId}}", "inboxes", "{{inboxId}}", "messages"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "last_id", "value": "" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Messages retrieved', () => {",
              "  pm.response.to.have.status(200);",
              "  const messages = pm.response.json();",
              "  pm.expect(messages.length).to.be.above(0);",
              "});",
              "",
              "const messages = pm.response.json();",
              "const latest = messages[0];",
              "",
              "console.log('Latest email subject:', latest.subject);",
              "console.log('From:', latest.from_email);",
              "console.log('To:', latest.to_email);",
              "console.log('Created at:', latest.created_at);",
              "",
              "pm.collectionVariables.set('messageId', latest.id);",
              "console.log('Message ID saved:', latest.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Get Email HTML Body & Parse confirm_url",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Api-Token", "value": "{{mailtrapToken}}" }
        ],
        "url": {
          "raw": "https://mailtrap.io/api/accounts/{{accountId}}/inboxes/{{inboxId}}/messages/{{messageId}}/body.html",
          "protocol": "https",
          "host": ["mailtrap", "io"],
          "path": ["api", "accounts", "{{accountId}}", "inboxes", "{{inboxId}}", "messages", "{{messageId}}", "body.html"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Email body retrieved', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const html = pm.response.text();",
              "",
              "// Strategy 1: Tìm link có chứa 'confirm-email' hoặc 'confirm' trong href",
              "let confirmUrl = null;",
              "",
              "// Regex tìm tất cả href links",
              "const hrefRegex = /href=[\"']([^\"']*)[\"']/gi;",
              "let match;",
              "const allLinks = [];",
              "",
              "while ((match = hrefRegex.exec(html)) !== null) {",
              "  allLinks.push(match[1]);",
              "}",
              "",
              "console.log('All links found:', JSON.stringify(allLinks, null, 2));",
              "",
              "// Tìm link confirm-email (ưu tiên)",
              "confirmUrl = allLinks.find(link => ",
              "  link.includes('confirm-email') || ",
              "  link.includes('confirm_email') ||",
              "  link.includes('email-confirmation') ||",
              "  link.includes('/confirm')",
              ");",
              "",
              "// Fallback: tìm link có chứa 'token' hoặc 'userId'",
              "if (!confirmUrl) {",
              "  confirmUrl = allLinks.find(link => ",
              "    link.includes('token=') && link.includes('userId=')",
              "  );",
              "}",
              "",
              "// Fallback 2: tìm trong text dạng URL thuần (không trong href)",
              "if (!confirmUrl) {",
              "  const urlRegex = /https?:\\/\\/[^\\s<>\"']+confirm[^\\s<>\"']*/gi;",
              "  const textMatch = urlRegex.exec(html);",
              "  if (textMatch) confirmUrl = textMatch[0];",
              "}",
              "",
              "if (confirmUrl) {",
              "  // Decode HTML entities nếu có",
              "  confirmUrl = confirmUrl.replace(/&amp;/g, '&');",
              "  ",
              "  pm.collectionVariables.set('confirmUrl', confirmUrl);",
              "  console.log('=== CONFIRM URL FOUND ===');",
              "  console.log(confirmUrl);",
              "  ",
              "  // Parse ra userId và token từ URL",
              "  try {",
              "    const url = new URL(confirmUrl);",
              "    const userId = url.searchParams.get('userId') || url.searchParams.get('UserId');",
              "    const token = url.searchParams.get('token') || url.searchParams.get('Token');",
              "    ",
              "    if (userId) {",
              "      pm.collectionVariables.set('userId', userId);",
              "      console.log('userId:', userId);",
              "    }",
              "    if (token) {",
              "      pm.collectionVariables.set('emailToken', token);",
              "      console.log('token:', token);",
              "    }",
              "  } catch(e) {",
              "    console.log('URL parse note:', e.message);",
              "  }",
              "  ",
              "  pm.test('Confirm URL extracted', () => {",
              "    pm.expect(confirmUrl).to.include('http');",
              "  });",
              "} else {",
              "  console.log('=== NO CONFIRM URL FOUND ===');",
              "  console.log('HTML preview (first 500 chars):', html.substring(0, 500));",
              "  pm.test('Confirm URL found', () => pm.expect.fail('No confirm URL found in email'));",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
