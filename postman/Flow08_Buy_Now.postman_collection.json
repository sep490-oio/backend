{
  "info": {
    "name": "Flow 08: Buy Now",
    "description": "Buy Now flow: execute buy-now on an auction, then create payment URL to complete purchase.\n\n**Actors**: Buyer\n**Prerequisite**: Flow 06 (Auction with BuyNowPrice, published and active)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "buyerToken", "value": "" },
    { "key": "auctionId", "value": "PASTE_AUCTION_ID_HERE" },
    { "key": "buyNowReservationId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "0.1 Login as Buyer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"buyer@example.com\",\n  \"password\": \"Test@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.accessToken) pm.collectionVariables.set('buyerToken', res.accessToken);"] } }]
        }
      ]
    },
    {
      "name": "Buy Now Flow",
      "item": [
        {
          "name": "8.1 Buy Now (REST)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/buy-now", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "buy-now"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.buyNowReservationId) pm.collectionVariables.set('buyNowReservationId', res.buyNowReservationId);", "pm.test('Buy Now reserved', () => pm.response.to.have.status(201));"] } }]
        },
        {
          "name": "8.2 Create Payment URL (for buy-now)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/vnpay/create-url", "host": ["{{baseUrl}}"], "path": ["api", "payments", "vnpay", "create-url"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 120000000,\n  \"currency\": \"VND\",\n  \"purpose\": \"auction_buy_now\",\n  \"description\": \"Buy Now payment for auction\",\n  \"auctionId\": \"{{auctionId}}\",\n  \"buyNowReservationId\": \"{{buyNowReservationId}}\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "console.log('VNPay URL:', res.paymentUrl);", "pm.test('Payment URL created', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    }
  ]
}
