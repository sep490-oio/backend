{
  "info": {
    "name": "Flow 17 — Activity Views",
    "_postman_id": "flow17-activity-views",
    "description": "Activity views flow covering my auctions, my bids, watchlist management, my items, my orders, my auto-bid, my wallet (balance, transactions, withdrawals), and error cases (401 unauthorized, empty auto-bid).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "walletTransactionId", "value": "" }
  ],
  "item": [
    {
      "name": "01-My Auctions",
      "item": [
        {
          "name": "1. Get My Auctions (GET /api/me/auctions)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/auctions?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "auctions"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            },
            "description": "Retrieve a paginated list of the current user's auctions (as seller). Returns all auctions regardless of status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 – my auctions retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body) {",
                  "    console.log('Total items:', body.totalCount || body.items?.length);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Get My Auctions — filter by status=active (GET /api/me/auctions?status=active)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/auctions?status=active&pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "auctions"],
              "query": [
                { "key": "status", "value": "active" },
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            },
            "description": "Retrieve the current user's auctions filtered by active status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 – active auctions retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02-My Bids",
      "item": [
        {
          "name": "3. Get My Bids (GET /api/me/bids)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/bids?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "bids"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            },
            "description": "Retrieve a paginated list of the current user's bids across all auctions."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 – my bids retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body) {",
                  "    console.log('Total bids:', body.totalCount || body.items?.length);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Get My Bids — filter by status=winning (GET /api/me/bids?status=winning)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/bids?status=winning&pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "bids"],
              "query": [
                { "key": "status", "value": "winning" },
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            },
            "description": "Retrieve the current user's bids filtered to only those currently winning."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 – winning bids retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03-Watchlist",
      "item": [
        {
          "name": "5. Watch Auction (POST /api/auctions/:auctionId/watch)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notifyOnBid\": true,\n  \"notifyOnEnd\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/watch",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions", "{{auctionId}}", "watch"]
            },
            "description": "Add an auction to the current user's watchlist with notification preferences for bid and end events."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 or 204 – auction watched', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Get My Watchlist (GET /api/me/auctions/watch-list)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/auctions/watch-list?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "auctions", "watch-list"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            },
            "description": "Retrieve the current user's auction watchlist with pagination."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 – watchlist retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Unwatch Auction (DELETE /api/auctions/:auctionId/watch)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/watch",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions", "{{auctionId}}", "watch"]
            },
            "description": "Remove an auction from the current user's watchlist."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 or 204 – auction unwatched', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04-My Items",
      "item": [
        {
          "name": "8. Get My Items (GET /api/items/my)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/my?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items", "my"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            },
            "description": "Retrieve the current user's items (as seller) with pagination."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 – my items retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05-My Orders",
      "item": [
        {
          "name": "9. Get My Orders (GET /api/me/orders)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "orders"]
            },
            "description": "Retrieve the current user's orders (both as buyer and seller)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 – my orders retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06-My Auto-Bid",
      "item": [
        {
          "name": "10. Get My Auto-Bid (GET /api/auctions/:auctionId/auto-bid/my)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/auto-bid/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions", "{{auctionId}}", "auto-bid", "my"]
            },
            "description": "Retrieve the current user's auto-bid configuration for a specific auction. Returns null/empty if no auto-bid is configured."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 – auto-bid config retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "console.log('Auto-bid config:', JSON.stringify(body));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "07-My Wallet",
      "item": [
        {
          "name": "11. Get My Wallet (GET /api/me/wallet)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/wallet",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "wallet"]
            },
            "description": "Retrieve the current user's wallet balance and details."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 – wallet retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body) {",
                  "    console.log('Wallet balance:', body.balance);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "12. Get Wallet Transactions (GET /api/me/wallet/transactions)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/wallet/transactions?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "wallet", "transactions"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            },
            "description": "Retrieve the current user's wallet transactions with pagination."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 – wallet transactions retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body && body.items && body.items.length > 0) {",
                  "    const txId = body.items[0].id || body.items[0].transactionId;",
                  "    if (txId) {",
                  "        pm.collectionVariables.set('walletTransactionId', txId);",
                  "        console.log('Extracted walletTransactionId:', txId);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "13. Get Wallet Transaction by ID (GET /api/me/wallet/transactions/:transactionId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/wallet/transactions/{{walletTransactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "wallet", "transactions", "{{walletTransactionId}}"]
            },
            "description": "Retrieve a specific wallet transaction by ID. Uses walletTransactionId extracted from request 12."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 – transaction detail retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body) {",
                  "    console.log('Transaction type:', body.type);",
                  "    console.log('Transaction amount:', body.amount);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "14. Get My Withdrawals (GET /api/me/wallet/withdrawals)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/wallet/withdrawals?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "wallet", "withdrawals"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            },
            "description": "Retrieve the current user's wallet withdrawal requests with pagination."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 – withdrawals retrieved', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "08-Error Cases",
      "item": [
        {
          "name": "15. Get My Auctions — no auth (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/api/me/auctions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "auctions"]
            },
            "description": "Attempt to retrieve auctions without authentication. Expects 401 Unauthorized."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 – unauthorized without auth', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "16. Get My Auto-Bid — expect null/empty when none configured",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/auto-bid/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions", "{{auctionId}}", "auto-bid", "my"]
            },
            "description": "Retrieve auto-bid for an auction where no auto-bid is configured. Expects a successful response with null or empty body."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 or 404 – no auto-bid configured', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.test('Response is null or empty when no auto-bid', function () {",
                  "        pm.expect(body === null || body.data === null || Object.keys(body).length === 0).to.be.true;",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
