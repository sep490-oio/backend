				{
					"name": "Upload to Cloudinary (PDF)",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "file", "type": "file", "src": "" },
								{ "key": "public_id", "value": "{{cloudinaryPublicId}}", "type": "text" },
								{ "key": "signature", "value": "{{cloudinarySignature}}", "type": "text" },
								{ "key": "timestamp", "value": "{{cloudinaryTimestamp}}", "type": "text" },
								{ "key": "api_key", "value": "{{cloudinaryApiKey}}", "type": "text" },
								{ "key": "folder", "value": "{{cloudinaryFolder}}", "type": "text" },
								{ "key": "allowed_formats", "value": "{{cloudinaryAllowedFormats}}", "type": "text" }
							]
						},
						"url": {
							"raw": "{{uploadUrl}}",
							"host": ["{{uploadUrl}}"]
						},
						"description": "Select a PDF document file. This uploads directly to Cloudinary. No eager transformation for documents."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Cloudinary upload successful', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Save upload result to collection vars', function () {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('confirmedSecureUrl', json.secure_url || '');",
									"    pm.collectionVariables.set('confirmedBytes', String(json.bytes || 0));",
									"    pm.collectionVariables.set('confirmedFormat', json.format || '');",
									"    // Documents don't have width/height",
									"    pm.collectionVariables.set('confirmedWidth', '0');",
									"    pm.collectionVariables.set('confirmedHeight', '0');",
									"});"
								]
							}
						}
					]
				},
				{
