		{
			"name": "06 – Error Cases",
			"item": [
				{
					"name": "Confirm (wrong publicId)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Idempotency-Key", "value": "{{$guid}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mediaUploadId\": \"{{mediaUploadId}}\",\n  \"publicId\": \"wrong_public_id\",\n  \"secureUrl\": \"https://example.com/fake.jpg\",\n  \"bytes\": 1000,\n  \"format\": \"jpg\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/media/confirm",
							"host": ["{{baseUrl}}"],
							"path": ["api", "media", "confirm"]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 409 (PublicIdMismatch)', function () {",
									"    pm.response.to.have.status(409);",
									"});",
									"",
									"pm.test('Error indicates PublicIdMismatch', function () {",
									"    var json = pm.response.json();",
									"    var body = JSON.stringify(json).toLowerCase();",
									"    pm.expect(body).to.include('publicidmismatch').or.include('public_id').or.include('mismatch');",
									"});"
								]
							}
						}
					]
				},
