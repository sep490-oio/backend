									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "05 – Document Upload (term_document)",
			"item": [
				{
					"name": "Request Signature (term_document)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Idempotency-Key", "value": "{{$guid}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"context\": \"term_document\",\n  \"fileName\": \"terms.pdf\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/media/upload-signature",
							"host": ["{{baseUrl}}"],
							"path": ["api", "media", "upload-signature"]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Save all signature fields and verify resourceType and eager', function () {",
									"    var json = pm.response.json();",
									"    pm.collectionVariables.set('mediaUploadId', json.mediaUploadId || json.id || '');",
									"    pm.collectionVariables.set('uploadUrl', json.uploadUrl || '');",
									"    pm.collectionVariables.set('cloudinarySignature', json.signature || '');",
									"    pm.collectionVariables.set('cloudinaryTimestamp', String(json.timestamp || ''));",
									"    pm.collectionVariables.set('cloudinaryApiKey', json.apiKey || '');",
									"    pm.collectionVariables.set('cloudinaryCloudName', json.cloudName || '');",
									"    pm.collectionVariables.set('cloudinaryPublicId', json.publicId || '');",
									"    pm.collectionVariables.set('cloudinaryStoragePublicId', json.storagePublicId || '');",
									"    pm.collectionVariables.set('cloudinaryFolder', json.folder || '');",
									"    pm.collectionVariables.set('cloudinaryEager', json.eager || '');",
									"    pm.collectionVariables.set('cloudinaryResourceType', json.resourceType || '');",
									"    pm.collectionVariables.set('cloudinaryAllowedFormats', json.allowedFormats || '');",
									"    pm.expect(json.resourceType).to.be.oneOf(['raw', 'document']);",
									"    pm.expect(json.eager).to.be.oneOf([null, undefined, '']);",
									"    console.log('resourceType:', json.resourceType);",
									"    console.log('eager:', json.eager);",
									"});"
								]
							}
						}
