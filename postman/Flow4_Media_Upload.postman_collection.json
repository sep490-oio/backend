	"item": [
		{
			"name": "01 – Upload Contexts",
			"item": [
				{
					"name": "Get Upload Contexts",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/media/contexts",
							"host": ["{{baseUrl}}"],
							"path": ["api", "media", "contexts"]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Log all context names', function () {",
									"    var json = pm.response.json();",
									"    if (Array.isArray(json)) {",
									"        json.forEach(function (ctx) {",
									"            console.log('Context:', ctx.name || ctx.context || JSON.stringify(ctx));",
									"        });",
									"    } else if (json.data && Array.isArray(json.data)) {",
									"        json.data.forEach(function (ctx) {",
									"            console.log('Context:', ctx.name || ctx.context || JSON.stringify(ctx));",
									"        });",
									"    } else {",
									"        console.log('Response:', JSON.stringify(json));",
									"    }",
									"});"
								]
							}
						}
					]
				}
			]
		},
