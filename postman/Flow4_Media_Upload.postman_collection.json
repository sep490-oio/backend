							{ "key": "Idempotency-Key", "value": "{{$guid}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mediaUploadId\": \"{{mediaUploadId}}\",\n  \"publicId\": \"{{cloudinaryPublicId}}\",\n  \"secureUrl\": \"{{confirmedSecureUrl}}\",\n  \"bytes\": {{confirmedBytes}},\n  \"format\": \"{{confirmedFormat}}\",\n  \"width\": {{confirmedWidth}},\n  \"height\": {{confirmedHeight}}\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/media/confirm",
							"host": ["{{baseUrl}}"],
							"path": ["api", "media", "confirm"]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Generate and save idempotency key so the retry request can reuse it",
									"var key = pm.variables.replaceIn('{{$guid}}');",
									"pm.collectionVariables.set('imageConfirmIdempotencyKey', key);",
									"pm.request.headers.upsert({ key: 'Idempotency-Key', value: key });"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response has mediaUploadId', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json).to.have.property('mediaUploadId');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Confirm Upload (idempotent retry)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Idempotency-Key", "value": "{{imageConfirmIdempotencyKey}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mediaUploadId\": \"{{mediaUploadId}}\",\n  \"publicId\": \"{{cloudinaryPublicId}}\",\n  \"secureUrl\": \"{{confirmedSecureUrl}}\",\n  \"bytes\": {{confirmedBytes}},\n  \"format\": \"{{confirmedFormat}}\",\n  \"width\": {{confirmedWidth}},\n  \"height\": {{confirmedHeight}}\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{baseUrl}}/api/media/confirm",
							"host": ["{{baseUrl}}"],
							"path": ["api", "media", "confirm"]
						},
						"description": "Retry with same key → should return cached 201 response"
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 201 (idempotent cached response)', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response has same mediaUploadId', function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json).to.have.property('mediaUploadId');",
									"    pm.expect(json.mediaUploadId).to.eql(pm.collectionVariables.get('mediaUploadId'));",
									"});"
								]
							}
						}
					]
				}
			]
		},
