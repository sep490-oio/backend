{
  "info": {
    "name": "Flow 6: Thanh toán → Vận chuyển → Hoàn tất",
    "description": "Luồng sau đấu giá: winner thanh toán, seller gửi hàng về kho, kho kiểm tra & gửi cho buyer, escrow settlement.\n\n**Actors**: Winner (Buyer), Seller, Warehouse Staff, System\n**Prerequisite**: Auction đã Sold (từ Flow 4 hoặc Flow 5)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "winnerToken", "value": "" },
    { "key": "sellerToken", "value": "" },
    { "key": "warehouseToken", "value": "" },
    { "key": "orderId", "value": "PASTE_ORDER_ID_HERE" },
    { "key": "auctionId", "value": "PASTE_AUCTION_ID_HERE" },
    { "key": "inboundShipmentId", "value": "" },
    { "key": "warehouseItemId", "value": "" },
    { "key": "outboundShipmentId", "value": "" },
    { "key": "storageLocationId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "0.1 Login as Winner",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"buyer1@example.com\",\n  \"password\": \"Test@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.accessToken) pm.collectionVariables.set('winnerToken', res.accessToken);"] } }]
        },
        {
          "name": "0.2 Login as Seller",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"seller@example.com\",\n  \"password\": \"Test@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.accessToken) pm.collectionVariables.set('sellerToken', res.accessToken);"] } }]
        },
        {
          "name": "0.3 Login as Warehouse Staff",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"warehouse@example.com\",\n  \"password\": \"Test@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.accessToken) pm.collectionVariables.set('warehouseToken', res.accessToken);"] } }]
        }
      ]
    },
    {
      "name": "1. Winner Payment",
      "item": [
        {
          "name": "6.1 [Winner] Get Notifications (auction won)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{winnerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/notifications", "host": ["{{baseUrl}}"], "path": ["api", "notifications"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Notifications retrieved', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "6.2 [Winner] Get My Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{winnerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/me/orders", "host": ["{{baseUrl}}"], "path": ["api", "me", "orders"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.items && res.items.length > 0) {", "  pm.collectionVariables.set('orderId', res.items[0].id);", "}"] } }]
        },
        {
          "name": "6.3 [Winner] Checkout Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{winnerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/checkout", "host": ["{{baseUrl}}"], "path": ["api", "payments", "checkout"] },
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"bankCode\": \"NCB\",\n  \"returnUrl\": \"http://localhost:3000/payment/return\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "console.log('VNPay URL:', res.paymentUrl);", "pm.test('Checkout success', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "6.4 [Winner] Verify Order Paid",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{winnerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "console.log('Order status:', res.status);"] } }]
        }
      ]
    },
    {
      "name": "2. Inbound Shipping (Seller → Warehouse)",
      "item": [
        {
          "name": "6.5 [Seller] Configure Auction Shipping",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/shipping", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "shipping"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderName\": \"Nguyen Van A\",\n  \"senderPhone\": \"0901234567\",\n  \"senderAddress\": \"123 Nguyen Hue, Quan 1, TP.HCM\",\n  \"weightGrams\": 500,\n  \"lengthCm\": 20,\n  \"widthCm\": 15,\n  \"heightCm\": 10,\n  \"insuranceValue\": 50000000\n}"
            }
          }
        },
        {
          "name": "6.6 [Seller] Book Inbound Shipment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/warehouse/inbound-shipments", "host": ["{{baseUrl}}"], "path": ["api", "warehouse", "inbound-shipments"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"PASTE_ITEM_ID_HERE\",\n  \"providerCode\": \"ghn\",\n  \"senderName\": \"Nguyen Van A\",\n  \"senderPhone\": \"0901234567\",\n  \"senderAddress\": \"123 Nguyen Hue, Quan 1, TP.HCM\",\n  \"weightGrams\": 500,\n  \"lengthCm\": 20,\n  \"widthCm\": 15,\n  \"heightCm\": 10,\n  \"insuranceValue\": 50000000\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.id) pm.collectionVariables.set('inboundShipmentId', res.id);"] } }]
        },
        {
          "name": "6.7 [Seller] Track Inbound Shipment",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{sellerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/warehouse/inbound-shipments/{{inboundShipmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "warehouse", "inbound-shipments", "{{inboundShipmentId}}"] }
          }
        }
      ]
    },
    {
      "name": "3. Warehouse Inspection & Storage",
      "item": [
        {
          "name": "6.8 [Warehouse] Get Inspection Queue",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{warehouseToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/warehouse/inbound-shipments/inspection-queue", "host": ["{{baseUrl}}"], "path": ["api", "warehouse", "inbound-shipments", "inspection-queue"] }
          }
        },
        {
          "name": "6.9 [Warehouse] Inspect Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{warehouseToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/warehouse/inbound-shipments/{{inboundShipmentId}}/inspect", "host": ["{{baseUrl}}"], "path": ["api", "warehouse", "inbound-shipments", "{{inboundShipmentId}}", "inspect"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conditionOnArrival\": \"VeryGood\",\n  \"inspectionNotes\": \"Hàng đúng mô tả, tình trạng tốt\",\n  \"evidence\": {\n    \"images\": [\n      {\n        \"publicId\": \"inspection/img1\",\n        \"secureUrl\": \"https://res.cloudinary.com/demo/image/upload/inspection1.jpg\",\n        \"fileName\": \"inspection1.jpg\"\n      }\n    ]\n  }\n}"
            }
          }
        },
        {
          "name": "6.10 [Warehouse] Review & Approve Inspection",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{warehouseToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/warehouse/inbound-shipments/{{inboundShipmentId}}/review", "host": ["{{baseUrl}}"], "path": ["api", "warehouse", "inbound-shipments", "{{inboundShipmentId}}", "review"] },
            "body": { "mode": "raw", "raw": "{\n  \"decision\": \"Approved\"\n}" }
          }
        },
        {
          "name": "6.11 [Warehouse] Get Storage Locations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{warehouseToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/warehouse/storage-locations", "host": ["{{baseUrl}}"], "path": ["api", "warehouse", "storage-locations"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.length > 0) pm.collectionVariables.set('storageLocationId', res[0].id);"] } }]
        },
        {
          "name": "6.12 [Warehouse] Store Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{warehouseToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/warehouse/warehouse-items/{{warehouseItemId}}/store", "host": ["{{baseUrl}}"], "path": ["api", "warehouse", "warehouse-items", "{{warehouseItemId}}", "store"] },
            "body": { "mode": "raw", "raw": "{\n  \"storageLocationId\": \"{{storageLocationId}}\",\n  \"locationLabel\": \"A1-01\"\n}" }
          }
        }
      ]
    },
    {
      "name": "4. Outbound Shipping (Warehouse → Buyer)",
      "item": [
        {
          "name": "6.13 [Warehouse] Book Outbound Shipment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{warehouseToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/warehouse/outbound-shipments", "host": ["{{baseUrl}}"], "path": ["api", "warehouse", "outbound-shipments"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"warehouseItemId\": \"{{warehouseItemId}}\",\n  \"providerCode\": \"ghn\",\n  \"weightGrams\": 500,\n  \"lengthCm\": 20,\n  \"widthCm\": 15,\n  \"heightCm\": 10\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.id) pm.collectionVariables.set('outboundShipmentId', res.id);"] } }]
        },
        {
          "name": "6.14 [Warehouse] Track Outbound Shipment",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{warehouseToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/warehouse/outbound-shipments/{{outboundShipmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "warehouse", "outbound-shipments", "{{outboundShipmentId}}"] }
          }
        },
        {
          "name": "6.15 [Winner] Check Order Status (Delivered)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{winnerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "console.log('Order status:', res.status);", "console.log('Decision window ends:', res.decisionWindowEndsAt);"] } }]
        }
      ]
    },
    {
      "name": "5. Settlement",
      "item": [
        {
          "name": "6.16 [Seller] Check Wallet Balance (after escrow release)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{sellerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/me/wallet", "host": ["{{baseUrl}}"], "path": ["api", "me", "wallet"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "console.log('Balance:', res.balanceAmount);", "console.log('Pending:', res.pendingBalanceAmount);"] } }]
        },
        {
          "name": "6.17 [Seller] Get Wallet Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{sellerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/me/wallet/transactions", "host": ["{{baseUrl}}"], "path": ["api", "me", "wallet", "transactions"] }
          }
        },
        {
          "name": "6.18 [Seller] Request Withdrawal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/me/wallet/withdrawals", "host": ["{{baseUrl}}"], "path": ["api", "me", "wallet", "withdrawals"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50000000,\n  \"bankName\": \"Vietcombank\",\n  \"accountNumber\": \"0123456789\",\n  \"accountHolder\": \"NGUYEN VAN A\"\n}"
            }
          }
        }
      ]
    }
  ]
}
