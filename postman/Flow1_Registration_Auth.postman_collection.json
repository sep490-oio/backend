		{
			"name": "07-TOTP 2FA",
			"item": [
				{
					"name": "15. Setup TOTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response contains sharedKey and QR code', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.sharedKey).to.be.a('string').and.not.empty;",
									"    pm.collectionVariables.set('totpSecret', jsonData.sharedKey);",
									"    console.log('Saved sharedKey to collection var totpSecret:', jsonData.sharedKey);",
									"    if (jsonData.qrCodeBase64) {",
									"        console.log('QR Code Base64:', jsonData.qrCodeBase64);",
									"    }",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{ "key": "token", "value": "{{accessToken}}", "type": "string" }
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/me/two-factor/setup",
							"host": ["{{baseUrl}}"],
							"path": ["api", "me", "two-factor", "setup"]
						}
