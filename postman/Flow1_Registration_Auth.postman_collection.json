		{
			"name": "03-Login",
			"item": [
				{
					"name": "6. Login (Happy, No 2FA)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response contains tokens and requiresTwoFactor is false', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.requiresTwoFactor).to.eql(false);",
									"    pm.expect(jsonData.accessToken).to.be.a('string').and.not.empty;",
									"    pm.expect(jsonData.refreshToken).to.be.a('string').and.not.empty;",
									"    pm.environment.set('accessToken', jsonData.accessToken);",
									"    pm.environment.set('refreshToken', jsonData.refreshToken);",
									"    console.log('Saved accessToken and refreshToken to environment');",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"account\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
