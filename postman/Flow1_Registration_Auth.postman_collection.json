						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"code\": \"{{totpCode}}\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/two-factor/verify",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "two-factor", "verify"]
						}
					}
				},
				{
					"name": "18. Regenerate Recovery Codes",
					"event": [
						{
							"listen": "test",
							"script": {
