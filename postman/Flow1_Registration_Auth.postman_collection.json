					}
				},
				{
					"name": "17. Verify TOTP Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response contains full tokens after 2FA verification', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.accessToken).to.be.a('string').and.not.empty;",
									"    pm.expect(jsonData.refreshToken).to.be.a('string').and.not.empty;",
									"    pm.environment.set('accessToken', jsonData.accessToken);",
									"    pm.environment.set('refreshToken', jsonData.refreshToken);",
									"    console.log('2FA verified – saved full accessToken and refreshToken to environment');",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{ "key": "token", "value": "{{twoFactorToken}}", "type": "string" }
							]
