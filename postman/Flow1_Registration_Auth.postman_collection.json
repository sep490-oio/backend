									"    pm.collectionVariables.set('recoveryCode', jsonData.recoveryCodes[0]);",
									"    console.log('Saved first recovery code to collection var:', jsonData.recoveryCodes[0]);",
									"    console.log('All recovery codes:', JSON.stringify(jsonData.recoveryCodes));",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": {
