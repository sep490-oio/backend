{
	"info": {
		"_postman_id": "flow1-registration-auth",
		"name": "Flow 1 – Registration & Auth",
		"description": "Tests all 24 Registration & Auth endpoints across 10 folders.\n\nRequires the OIO Auction - Shared Environment to be selected.\n\nManual steps:\n- Set emailToken from Mailtrap before running Confirm Email.\n- Set resetToken from email before running Reset Password.\n- Generate totpCode from sharedKey before running TOTP requests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "totpSecret", "value": "" },
		{ "key": "recoveryCode", "value": "" },
		{ "key": "twoFactorToken", "value": "" },
		{ "key": "emailToken", "value": "" },
		{ "key": "resetToken", "value": "" },
		{ "key": "sessionId", "value": "" }
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"if (!pm.environment.get('deviceId') || pm.environment.get('deviceId') === '') {",
					"    pm.environment.set('deviceId', pm.variables.replaceIn('{{$guid}}'));",
					"}"
				]
			}
		}
	],
	"item": [
		{
			"name": "01-Registration",
			"item": [
				{
					"name": "1. Register User (Happy)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response contains user id', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.be.a('string').and.not.empty;",
									"    pm.environment.set('userId', jsonData.id);",
									"    console.log('Saved userId:', jsonData.id);",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userName\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"currency\": \"VND\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "register"]
						}
					}
				},
