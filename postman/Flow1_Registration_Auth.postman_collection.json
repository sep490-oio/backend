				{
					"name": "8. Login (With 2FA → requiresTwoFactor)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Handle 2FA login response', function () {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.requiresTwoFactor === true) {",
									"        pm.expect(jsonData.accessToken).to.be.a('string').and.not.empty;",
									"        pm.collectionVariables.set('twoFactorToken', jsonData.accessToken);",
									"        console.log('2FA required – saved accessToken as twoFactorToken (collection var)');",
									"    } else {",
									"        pm.environment.set('accessToken', jsonData.accessToken);",
									"        pm.environment.set('refreshToken', jsonData.refreshToken);",
									"        console.log('No 2FA – saved tokens to environment');",
									"    }",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"account\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Run this after enabling 2FA. Response will have requiresTwoFactor=true"
					}
				}
			]
		},
