						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"account\": \"{{userEmail}}\",\n  \"password\": \"WrongPassword!1\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
