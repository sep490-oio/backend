{
  "info": {
    "name": "Flow 04: Media Upload",
    "description": "Media upload flow: get upload contexts, request signed URL, upload to Cloudinary, confirm upload.\n\n**Actors**: Authenticated User\n**Prerequisite**: Flow 01 (logged in)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "cloudName", "value": "" },
    { "key": "mediaUploadId", "value": "" },
    { "key": "uploadUrl", "value": "" },
    { "key": "apiKey", "value": "" },
    { "key": "signature", "value": "" },
    { "key": "timestamp", "value": "" },
    { "key": "folder", "value": "" },
    { "key": "publicId", "value": "" },
    { "key": "secureUrl", "value": "" }
  ],
  "item": [
    {
      "name": "01. Get Upload Contexts",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/media/contexts",
          "host": ["{{baseUrl}}"],
          "path": ["api", "media", "contexts"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Get upload contexts success', () => pm.response.to.have.status(200));",
              "const res = pm.response.json();",
              "console.log('Available contexts:', JSON.stringify(res));"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Request Upload Signature",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Idempotency-Key", "value": "{{$guid}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/media/upload-signature",
          "host": ["{{baseUrl}}"],
          "path": ["api", "media", "upload-signature"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"context\": \"item-image\",\n  \"fileName\": \"product_photo.jpg\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Upload signature obtained', () => pm.response.to.have.status(200));",
              "const res = pm.response.json();",
              "if (res.mediaUploadId) pm.collectionVariables.set('mediaUploadId', res.mediaUploadId);",
              "if (res.uploadUrl) pm.collectionVariables.set('uploadUrl', res.uploadUrl);",
              "if (res.cloudName) pm.collectionVariables.set('cloudName', res.cloudName);",
              "if (res.apiKey) pm.collectionVariables.set('apiKey', res.apiKey);",
              "if (res.signature) pm.collectionVariables.set('signature', res.signature);",
              "if (res.timestamp) pm.collectionVariables.set('timestamp', String(res.timestamp));",
              "if (res.folder) pm.collectionVariables.set('folder', res.folder);",
              "if (res.publicId) pm.collectionVariables.set('publicId', res.publicId);",
              "console.log('Upload signature response:', JSON.stringify(res));"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Upload to Cloudinary",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "https://api.cloudinary.com/v1_1/{{cloudName}}/image/upload",
          "protocol": "https",
          "host": ["api", "cloudinary", "com"],
          "path": ["v1_1", "{{cloudName}}", "image", "upload"]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": "" },
            { "key": "api_key", "value": "{{apiKey}}", "type": "text" },
            { "key": "signature", "value": "{{signature}}", "type": "text" },
            { "key": "timestamp", "value": "{{timestamp}}", "type": "text" },
            { "key": "folder", "value": "{{folder}}", "type": "text" },
            { "key": "public_id", "value": "{{publicId}}", "type": "text" }
          ]
        },
        "description": "Upload the actual file to Cloudinary using the signed parameters from step 02. Select a file in the 'file' form-data field."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Cloudinary upload success', () => pm.response.to.have.status(200));",
              "const res = pm.response.json();",
              "if (res.public_id) pm.collectionVariables.set('publicId', res.public_id);",
              "if (res.secure_url) pm.collectionVariables.set('secureUrl', res.secure_url);",
              "console.log('Cloudinary response - publicId:', res.public_id, 'secureUrl:', res.secure_url);"
            ]
          }
        }
      ]
    },
    {
      "name": "04. Confirm Upload",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Idempotency-Key", "value": "{{$guid}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/media/confirm",
          "host": ["{{baseUrl}}"],
          "path": ["api", "media", "confirm"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mediaUploadId\": \"{{mediaUploadId}}\",\n  \"publicId\": \"{{publicId}}\",\n  \"secureUrl\": \"{{secureUrl}}\",\n  \"bytes\": 150000,\n  \"format\": \"jpg\",\n  \"fileName\": \"product_photo.jpg\",\n  \"width\": 1920,\n  \"height\": 1080,\n  \"durationSeconds\": null\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Upload confirmed', () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "const res = pm.response.json();",
              "console.log('Confirm upload response:', JSON.stringify(res));"
            ]
          }
        }
      ]
    }
  ]
}
