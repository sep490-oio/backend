{
  "info": {
    "name": "Flow 8: Admin Operations & Monitoring",
    "description": "Luồng admin quản lý platform: monitoring alerts, collusion detection, user management, withdrawals.\n\n**Actors**: Admin\n**Prerequisite**: Admin account với quyền Admin",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "adminToken", "value": "" },
    { "key": "alertId", "value": "" },
    { "key": "auctionId", "value": "" },
    { "key": "emergencyId", "value": "" },
    { "key": "bidId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "withdrawalId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "0.1 Login as Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"admin@example.com\",\n  \"password\": \"Admin@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.accessToken) pm.collectionVariables.set('adminToken', res.accessToken);"] } }]
        }
      ]
    },
    {
      "name": "A. Monitoring & Alerts",
      "item": [
        {
          "name": "8.1 Get Monitoring Alerts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/monitoring-alerts?pageNumber=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "monitoring-alerts"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.items && res.items.length > 0) pm.collectionVariables.set('alertId', res.items[0].id);"] } }]
        },
        {
          "name": "8.2 Acknowledge Alert",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/monitoring-alerts/{{alertId}}/acknowledge", "host": ["{{baseUrl}}"], "path": ["api", "admin", "monitoring-alerts", "{{alertId}}", "acknowledge"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Alert acknowledged', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "8.3 Resolve Alert",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/monitoring-alerts/{{alertId}}/resolve", "host": ["{{baseUrl}}"], "path": ["api", "admin", "monitoring-alerts", "{{alertId}}", "resolve"] },
            "body": { "mode": "raw", "raw": "{\n  \"notes\": \"Đã kiểm tra, false positive do cùng mạng công ty.\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Alert resolved', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "B. Auction Emergency",
      "item": [
        {
          "name": "8.4 Trigger Auction Emergency",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/auctions/{{auctionId}}/emergencies", "host": ["{{baseUrl}}"], "path": ["api", "admin", "auctions", "{{auctionId}}", "emergencies"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"triggerSource\": \"manual\",\n  \"reason\": \"Phát hiện shill bidding từ seller\",\n  \"payload\": \"{\\\"suspectedUsers\\\": [\\\"user1\\\", \\\"user2\\\"]}\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.id) pm.collectionVariables.set('emergencyId', res.id);", "pm.test('Emergency triggered', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "8.5 Cancel Fraudulent Bid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/auctions/{{auctionId}}/bids/{{bidId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "admin", "auctions", "{{auctionId}}", "bids", "{{bidId}}", "cancel"] },
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Bid từ tài khoản shill, cùng IP với seller\"\n}" }
          }
        },
        {
          "name": "8.6 Resolve Emergency",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/auctions/{{auctionId}}/emergencies/{{emergencyId}}/resolve", "host": ["{{baseUrl}}"], "path": ["api", "admin", "auctions", "{{auctionId}}", "emergencies", "{{emergencyId}}", "resolve"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"Resolved\",\n  \"payload\": \"{\\\"action\\\": \\\"Cancelled fraudulent bids, warned seller\\\"}\"\n}" }
          }
        },
        {
          "name": "8.7 Set Auction Curation",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/auctions/{{auctionId}}/curation", "host": ["{{baseUrl}}"], "path": ["api", "admin", "auctions", "{{auctionId}}", "curation"] },
            "body": { "mode": "raw", "raw": "{\n  \"isFeatured\": true,\n  \"priority\": 90,\n  \"priorityReason\": \"High-value verified item\"\n}" }
          }
        }
      ]
    },
    {
      "name": "C. User Management",
      "item": [
        {
          "name": "8.8 Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users?pageNumber=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "8.9 Get User Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users", "{{userId}}"] }
          }
        },
        {
          "name": "8.10 Flag User for Risk",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/users/{{userId}}/risk-flags", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users", "{{userId}}", "risk-flags"] },
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Tham gia shill bidding trên nhiều phiên đấu giá\"\n}" }
          }
        },
        {
          "name": "8.11 Suspend User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/users/{{userId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users", "{{userId}}", "status"] },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"Suspended\"\n}" }
          }
        },
        {
          "name": "8.12 Get Roles",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/roles", "host": ["{{baseUrl}}"], "path": ["api", "admin", "roles"] }
          }
        },
        {
          "name": "8.13 Get Permissions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/permissions", "host": ["{{baseUrl}}"], "path": ["api", "admin", "permissions"] }
          }
        }
      ]
    },
    {
      "name": "D. Payment & Withdrawal Management",
      "item": [
        {
          "name": "8.14 Get Payment Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/payments/summary", "host": ["{{baseUrl}}"], "path": ["api", "admin", "payments", "summary"] }
          }
        },
        {
          "name": "8.15 Get All Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/payments/transactions?pageNumber=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "payments", "transactions"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "8.16 Get Escrows",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/payments/escrows", "host": ["{{baseUrl}}"], "path": ["api", "admin", "payments", "escrows"] }
          }
        },
        {
          "name": "8.17 Get Pending Withdrawals",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/payments/withdrawals", "host": ["{{baseUrl}}"], "path": ["api", "admin", "payments", "withdrawals"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.items && res.items.length > 0) pm.collectionVariables.set('withdrawalId', res.items[0].id);"] } }]
        },
        {
          "name": "8.18 Approve Withdrawal",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/payments/withdrawals/{{withdrawalId}}/approve", "host": ["{{baseUrl}}"], "path": ["api", "admin", "payments", "withdrawals", "{{withdrawalId}}", "approve"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Withdrawal approved', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "8.19 Reject Withdrawal (alternative)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/admin/payments/withdrawals/{{withdrawalId}}/reject", "host": ["{{baseUrl}}"], "path": ["api", "admin", "payments", "withdrawals", "{{withdrawalId}}", "reject"] },
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Tài khoản ngân hàng không khớp với thông tin xác minh\"\n}" }
          }
        }
      ]
    },
    {
      "name": "E. Terms Management",
      "item": [
        {
          "name": "8.20 Get All Terms Documents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/terms", "host": ["{{baseUrl}}"], "path": ["api", "admin", "terms"] }
          }
        },
        {
          "name": "8.21 Get Active Terms (public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/terms/active", "host": ["{{baseUrl}}"], "path": ["api", "terms", "active"] }
          }
        }
      ]
    }
  ]
}
