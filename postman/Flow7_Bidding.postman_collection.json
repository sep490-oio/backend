                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "My Bids",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me/bids?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "bids"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
