{
  "info": {
    "name": "Flow 06: Auction Lifecycle",
    "description": "Full auction lifecycle: create, configure timing/shipping, submit, publish, cancel, close, relist, runner-up offers.\n\n**Actors**: Seller, Admin\n**Prerequisite**: Flow 2 (Seller onboarded), Item approved or inline creation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "sellerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "itemId", "value": "PASTE_ITEM_ID_HERE" },
    { "key": "auctionId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "0.1 Login as Seller",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"seller@example.com\",\n  \"password\": \"Test@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.accessToken) pm.collectionVariables.set('sellerToken', res.accessToken);"] } }]
        },
        {
          "name": "0.2 Login as Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"admin@example.com\",\n  \"password\": \"Test@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.accessToken) pm.collectionVariables.set('adminToken', res.accessToken);"] } }]
        }
      ]
    },
    {
      "name": "Create & Configure",
      "item": [
        {
          "name": "6.1 Create Auction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions", "host": ["{{baseUrl}}"], "path": ["api", "auctions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Rolex Submariner 2024\",\n  \"condition\": \"LikeNew\",\n  \"categoryId\": null,\n  \"description\": \"Excellent condition, full box & papers\",\n  \"quantity\": 1,\n  \"startingPrice\": 50000000,\n  \"bidIncrement\": 1000000,\n  \"reservePrice\": 80000000,\n  \"buyNowPrice\": 120000000,\n  \"extensionMinutes\": 5,\n  \"currency\": \"VND\",\n  \"auctionType\": \"regular\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.id) pm.collectionVariables.set('auctionId', res.id);", "pm.test('Auction created', () => pm.response.to.have.status(201));"] } }]
        },
        {
          "name": "6.2 Create Auction from Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/items/{{itemId}}/auctions", "host": ["{{baseUrl}}"], "path": ["api", "items", "{{itemId}}", "auctions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startingPrice\": 50000000,\n  \"bidIncrement\": 1000000,\n  \"reservePrice\": 80000000,\n  \"buyNowPrice\": 120000000,\n  \"extensionMinutes\": 5,\n  \"currency\": \"VND\",\n  \"auctionType\": \"regular\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.id) pm.collectionVariables.set('auctionId', res.id);", "pm.test('Auction from item created', () => pm.response.to.have.status(201));"] } }]
        },
        {
          "name": "6.3 Get Auctions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auctions?pageNumber=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions"],
              "query": [
                { "key": "pageNumber", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auctions listed', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "6.4 Get Auction",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auction details', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "6.5 Update Auction",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startingPrice\": 55000000,\n  \"bidIncrement\": 2000000,\n  \"reservePrice\": 85000000,\n  \"buyNowPrice\": 130000000,\n  \"currency\": \"VND\",\n  \"auctionType\": \"regular\",\n  \"autoExtend\": true,\n  \"extensionMinutes\": 10\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auction updated', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "6.6 Set Timing",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/timing", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "timing"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"2026-04-01T10:00:00Z\",\n  \"endTime\": \"2026-04-03T10:00:00Z\",\n  \"qualificationStartAt\": \"2026-03-28T10:00:00Z\",\n  \"qualificationEndAt\": \"2026-04-01T09:00:00Z\",\n  \"autoExtend\": true,\n  \"extensionMinutes\": 5\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Timing set', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "6.7 Choose Shipping",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/shipping", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "shipping"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderName\": \"Nguyen Van A\",\n  \"senderPhone\": \"0901234567\",\n  \"senderAddress\": \"123 Le Loi\",\n  \"senderWard\": \"Ben Thanh\",\n  \"senderDistrict\": \"District 1\",\n  \"senderProvince\": \"Ho Chi Minh City\",\n  \"weightGrams\": 500,\n  \"insuranceValue\": 120000000,\n  \"providerCode\": \"GHN\",\n  \"lengthCm\": 30,\n  \"widthCm\": 20,\n  \"heightCm\": 15\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Shipping configured', () => pm.response.to.have.status(201));"] } }]
        }
      ]
    },
    {
      "name": "Submit & Publish",
      "item": [
        {
          "name": "6.8 Submit Auction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/submit", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "submit"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auction submitted', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "6.9 Publish Auction (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/publish", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "publish"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auction published', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Lifecycle Actions",
      "item": [
        {
          "name": "6.10 Cancel Auction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "cancel"] },
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Changed my mind about selling\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auction cancelled', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "6.11 Close Auction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/close", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "close"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auction closed', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "6.12 Relist Auction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/relist", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "relist"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qualificationStartAt\": \"2026-04-10T10:00:00Z\",\n  \"qualificationEndAt\": \"2026-04-14T09:00:00Z\",\n  \"startAt\": \"2026-04-15T10:00:00Z\",\n  \"endAt\": \"2026-04-17T10:00:00Z\",\n  \"startingPrice\": 45000000,\n  \"bidIncrement\": 1000000,\n  \"reason\": \"Previous auction had no winner\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auction relisted', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "6.13 Offer Runner-Up",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/runner-up-offers", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "runner-up-offers"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Runner-up offer sent', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "6.14 Respond Runner-Up",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/runner-up-offers/respond", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "runner-up-offers", "respond"] },
            "body": { "mode": "raw", "raw": "{\n  \"accept\": true\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Runner-up response sent', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "My Auctions",
      "item": [
        {
          "name": "6.15 Get My Auctions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/me/auctions", "host": ["{{baseUrl}}"], "path": ["api", "me", "auctions"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('My auctions listed', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    }
  ]
}
