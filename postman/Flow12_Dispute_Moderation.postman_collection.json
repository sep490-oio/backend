    {
      "name": "08-SignalR Reference & Errors",
      "item": [
        {
          "name": "26. [Info] DisputeHub SignalR methods & events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/disputes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "disputes"]
            },
            "description": "INFO-ONLY: DisputeHub SignalR reference.\n\nHub URL: /hubs/disputes (requires Bearer token)\n\nClient → Server methods:\n  - JoinDispute(disputeId: Guid) — Join a dispute room to receive real-time updates\n  - LeaveDispute(disputeId: Guid) — Leave a dispute room\n\nServer → Client events:\n  - MessageReceived(DisputeMessageDto) — New message in the dispute\n  - ReadStateUpdated(DisputeParticipantReadStateDto) — A participant's read state changed\n  - DisputeUpdated(DisputeThreadMetaDto) — Dispute metadata changed (status, assignment, etc.)\n  - DisputeUnreadUpdated(DisputeUnreadUpdateDto) — Unread count changed for the user\n\nGroup naming:\n  - dispute:{disputeId} — All participants\n  - dispute:{disputeId}:admins — Admin-only (internal messages)\n  - dispute-user:{userId} — Per-user notifications\n\nNote: SignalR connections cannot be tested directly in Postman. Use a SignalR client or the web app."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// INFO-ONLY request — DisputeHub SignalR reference.",
                  "// SignalR Hub URL: /hubs/disputes",
                  "// Client methods: JoinDispute(disputeId), LeaveDispute(disputeId)",
                  "// Server events: MessageReceived, ReadStateUpdated, DisputeUpdated, DisputeUnreadUpdated",
                  "console.log('[Info] DisputeHub — see request description for SignalR details.');"
                ]
              }
            }
          ]
        },
