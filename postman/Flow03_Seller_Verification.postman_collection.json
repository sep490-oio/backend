{
  "info": {
    "name": "Flow 03: Seller Verification & Onboarding",
    "description": "Identity verification (eKYC), document upload, seller profile creation, admin approval.\n\n**Actors**: Seller (registered user), Admin\n**Prerequisite**: Flow 01 (registered + logged in)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "verificationId", "value": "" },
    { "key": "docId", "value": "" },
    { "key": "sellerId", "value": "" },
    { "key": "mediaUploadId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login as Seller",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"seller@example.com\",\n  \"password\": \"Test@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "  pm.collectionVariables.set('token', res.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', res.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"admin@example.com\",\n  \"password\": \"Admin@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) pm.collectionVariables.set('adminToken', res.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Identity Verification",
      "item": [
        {
          "name": "01. Create Verification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me/verifications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "verifications"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verificationType\": \"GovernmentId\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Verification created', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "  pm.collectionVariables.set('verificationId', res.id);",
                  "  console.log('verificationId saved:', res.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02. Update Verification",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me/verifications/{{verificationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "verifications", "{{verificationId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van A\",\n  \"dateOfBirth\": \"1995-01-15\",\n  \"gender\": \"Male\",\n  \"idType\": \"CCCD\",\n  \"idNumber\": \"079095001234\",\n  \"idIssuedDate\": \"2021-06-15\",\n  \"idExpiredDate\": \"2036-06-15\",\n  \"idIssuedPlace\": \"Cuc CSQLHC ve TTXH\",\n  \"fullAddress\": \"123 Nguyen Hue, Quan 1, TP.HCM\",\n  \"province\": \"Ho Chi Minh\",\n  \"district\": \"Quan 1\",\n  \"ward\": \"Ben Nghe\",\n  \"nationality\": \"VN\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Verification updated', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "03. Upload Document (attach to verification)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me/verifications/{{verificationId}}/documents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "verifications", "{{verificationId}}", "documents"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mediaUploadId\": \"{{mediaUploadId}}\",\n  \"documentType\": \"IdFront\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Document uploaded', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "  pm.collectionVariables.set('docId', res.id);",
                  "  console.log('docId saved:', res.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04. Delete Document",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me/verifications/{{verificationId}}/documents/{{docId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "verifications", "{{verificationId}}", "documents", "{{docId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Document deleted', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "05. Submit Verification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me/verifications/{{verificationId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "verifications", "{{verificationId}}", "submit"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Verification submitted', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "06. Get My Verifications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me/verifications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "verifications"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Verifications retrieved', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "07. Get Verification by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me/verifications/{{verificationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "verifications", "{{verificationId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Verification retrieved', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Seller Profile",
      "item": [
        {
          "name": "08. Create Seller Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me/seller-profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "seller-profile"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeName\": \"Shop Nguyen Van A\",\n  \"storeDescription\": \"Chuyen do co va suu tam chat luong cao\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Seller profile created', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.id) {",
                  "  pm.collectionVariables.set('sellerId', res.id);",
                  "  console.log('sellerId saved:', res.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "09. Get Seller Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me/seller-profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "seller-profile"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Seller profile retrieved', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "if (res.id) pm.collectionVariables.set('sellerId', res.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "10. Update Seller Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me/seller-profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "seller-profile"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeName\": \"Shop Nguyen Van A - Updated\",\n  \"storeDescription\": \"Chuyen do co, suu tam va nghe thuat\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Seller profile updated', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Verification Dispute",
      "item": [
        {
          "name": "11. Create Verification Dispute",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me/verifications/{{verificationId}}/disputes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me", "verifications", "{{verificationId}}", "disputes"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Information was rejected incorrectly\",\n  \"correctedInfo\": {\n    \"fullName\": \"Nguyen Van A\",\n    \"dateOfBirth\": \"1995-01-15\",\n    \"gender\": \"Male\",\n    \"idType\": \"CCCD\",\n    \"idNumber\": \"079095001234\",\n    \"idIssuedDate\": \"2021-06-15\",\n    \"idExpiredDate\": \"2036-06-15\",\n    \"idIssuedPlace\": \"Cuc CSQLHC ve TTXH\",\n    \"fullAddress\": \"123 Nguyen Hue, Quan 1, TP.HCM\",\n    \"province\": \"Ho Chi Minh\",\n    \"district\": \"Quan 1\",\n    \"ward\": \"Ben Nghe\",\n    \"nationality\": \"VN\"\n  },\n  \"message\": \"Please review again, my documents are correct.\",\n  \"mediaUploadIds\": []\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Dispute created', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin Actions",
      "item": [
        {
          "name": "12. (Admin) Approve Verification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/verifications/{{verificationId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "verifications", "{{verificationId}}", "approve"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Verification approved', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "13. (Admin) Reject Verification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/verifications/{{verificationId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "verifications", "{{verificationId}}", "reject"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Documents are blurry and unreadable\",\n  \"rejectionCode\": \"BLURRY_DOCUMENT\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Verification rejected', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "14. (Admin) Verify Seller Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/seller-profiles/{{sellerId}}/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "seller-profiles", "{{sellerId}}", "verify"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Seller profile verified', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
