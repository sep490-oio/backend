{
  "info": {
    "name": "Flow 3: Đăng sản phẩm & Tạo phiên đấu giá",
    "description": "Luồng seller đăng item, upload media, admin duyệt, tạo và publish auction.\n\n**Actors**: Seller, Admin\n**Prerequisite**: Flow 2 (Seller đã Verified)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "sellerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "itemId", "value": "" },
    { "key": "auctionId", "value": "" },
    { "key": "mediaUploadId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "0.1 Login as Seller",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"seller@example.com\",\n  \"password\": \"Test@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.accessToken) pm.collectionVariables.set('sellerToken', res.accessToken);"] } }]
        },
        {
          "name": "0.2 Login as Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"admin@example.com\",\n  \"password\": \"Admin@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.accessToken) pm.collectionVariables.set('adminToken', res.accessToken);"] } }]
        }
      ]
    },
    {
      "name": "Create Item",
      "item": [
        {
          "name": "3.1 Get Categories",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/categories", "host": ["{{baseUrl}}"], "path": ["api", "categories"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.length > 0) pm.collectionVariables.set('categoryId', res[0].id);"] } }]
        },
        {
          "name": "3.2 Request Upload Signature (Item Image)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/media/upload-signature", "host": ["{{baseUrl}}"], "path": ["api", "media", "upload-signature"] },
            "body": { "mode": "raw", "raw": "{\n  \"context\": \"item-image\",\n  \"fileName\": \"product_photo_1.jpg\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.mediaUploadId) pm.collectionVariables.set('mediaUploadId', res.mediaUploadId);"] } }]
        },
        {
          "name": "3.3 Confirm Upload",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/media/confirm", "host": ["{{baseUrl}}"], "path": ["api", "media", "confirm"] },
            "body": { "mode": "raw", "raw": "{\n  \"mediaUploadId\": \"{{mediaUploadId}}\"\n}" }
          }
        },
        {
          "name": "3.4 Create Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/items", "host": ["{{baseUrl}}"], "path": ["api", "items"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Đồng hồ Rolex Submariner 1960\",\n  \"condition\": \"VeryGood\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"description\": \"Đồng hồ Rolex Submariner đời 1960, tình trạng rất tốt, đã được kiểm định.\",\n  \"quantity\": 1,\n  \"attributes\": {\n    \"brand\": \"Rolex\",\n    \"year\": 1960,\n    \"material\": \"Stainless Steel\"\n  }\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.id) pm.collectionVariables.set('itemId', res.id);", "pm.test('Item created', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "3.5 Add Media to Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/items/{{itemId}}/media", "host": ["{{baseUrl}}"], "path": ["api", "items", "{{itemId}}", "media"] },
            "body": { "mode": "raw", "raw": "{\n  \"mediaUploadId\": \"{{mediaUploadId}}\",\n  \"isPrimary\": true,\n  \"sortOrder\": 0\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Media added', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "3.6 Submit Item for Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/items/{{itemId}}/submit", "host": ["{{baseUrl}}"], "path": ["api", "items", "{{itemId}}", "submit"] },
            "body": { "mode": "raw", "raw": "{\n  \"verifyByPlatform\": false\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Item submitted', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Admin Review Item",
      "item": [
        {
          "name": "3.7 [Admin] Get Review Queue",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/items/review-queue", "host": ["{{baseUrl}}"], "path": ["api", "admin", "items", "review-queue"] }
          }
        },
        {
          "name": "3.8 [Admin] Approve Item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/items/{{itemId}}/approve", "host": ["{{baseUrl}}"], "path": ["api", "admin", "items", "{{itemId}}", "approve"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Item approved', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Create & Publish Auction",
      "item": [
        {
          "name": "3.9 Create Auction from Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/items/{{itemId}}/auctions", "host": ["{{baseUrl}}"], "path": ["api", "items", "{{itemId}}", "auctions"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startingPrice\": 50000000,\n  \"bidIncrement\": 1000000,\n  \"reservePrice\": 80000000,\n  \"buyNowPrice\": 150000000,\n  \"currency\": \"VND\",\n  \"auctionType\": \"Regular\",\n  \"extensionMinutes\": 5\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.id) pm.collectionVariables.set('auctionId', res.id);", "pm.test('Auction created', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "3.10 Submit Auction",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{sellerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/submit", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "submit"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auction submitted', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "3.11 Set Auction Timing",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/timing", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "timing"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"2026-03-20T10:00:00Z\",\n  \"endTime\": \"2026-03-20T22:00:00Z\",\n  \"qualificationStartAt\": \"2026-03-18T00:00:00Z\",\n  \"qualificationEndAt\": \"2026-03-20T09:00:00Z\",\n  \"autoExtend\": true,\n  \"extensionMinutes\": 5\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Timing set', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "3.12 Publish Auction",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{sellerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}/publish", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}", "publish"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auction published', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "3.13 Verify Auction Details",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auctions/{{auctionId}}", "host": ["{{baseUrl}}"], "path": ["api", "auctions", "{{auctionId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Auction retrieved', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    }
  ]
}
