{
  "info": {
    "name": "Flow 09: Payment",
    "description": "Payment flows: VNPay standard payments, token-based payments, payment methods management, checkout, and admin refunds.\n\n**Actors**: Buyer, Admin\n**Prerequisite**: Active auction or order exists",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "buyerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "auctionId", "value": "PASTE_AUCTION_ID_HERE" },
    { "key": "orderId", "value": "PASTE_ORDER_ID_HERE" },
    { "key": "methodId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "0.1 Login as Buyer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"buyer@example.com\",\n  \"password\": \"Test@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.accessToken) pm.collectionVariables.set('buyerToken', res.accessToken);"] } }]
        },
        {
          "name": "0.2 Login as Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"account\": \"admin@example.com\",\n  \"password\": \"Test@1234\",\n  \"deviceId\": \"{{$guid}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.accessToken) pm.collectionVariables.set('adminToken', res.accessToken);"] } }]
        }
      ]
    },
    {
      "name": "A. VNPay Standard Payment",
      "item": [
        {
          "name": "9.1 Create Payment URL (Deposit)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/vnpay/create-url", "host": ["{{baseUrl}}"], "path": ["api", "payments", "vnpay", "create-url"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000000,\n  \"currency\": \"VND\",\n  \"purpose\": \"auction_deposit\",\n  \"description\": \"Auction deposit payment\",\n  \"auctionId\": \"{{auctionId}}\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "console.log('VNPay URL:', res.paymentUrl);", "pm.test('Deposit payment URL created', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "9.2 Create Payment URL (Order)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/vnpay/create-url", "host": ["{{baseUrl}}"], "path": ["api", "payments", "vnpay", "create-url"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100000000,\n  \"currency\": \"VND\",\n  \"purpose\": \"order_payment\",\n  \"description\": \"Order payment\",\n  \"orderId\": \"{{orderId}}\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "console.log('VNPay URL:', res.paymentUrl);", "pm.test('Order payment URL created', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "9.3 Create Payment URL (Wallet Topup)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/vnpay/create-url", "host": ["{{baseUrl}}"], "path": ["api", "payments", "vnpay", "create-url"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10000000,\n  \"currency\": \"VND\",\n  \"purpose\": \"wallet_top_up\",\n  \"description\": \"Wallet top-up\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "console.log('VNPay URL:', res.paymentUrl);", "pm.test('Wallet topup URL created', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "B. Token Payment",
      "item": [
        {
          "name": "9.4 Link Card",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/methods/link-card", "host": ["{{baseUrl}}"], "path": ["api", "payments", "methods", "link-card"] },
            "body": { "mode": "raw", "raw": "{\n  \"cardType\": \"ATM\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "console.log('Link card URL:', res.linkUrl);", "pm.test('Link card URL created', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "9.5 Create Payment URL (with saved token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/vnpay/create-url", "host": ["{{baseUrl}}"], "path": ["api", "payments", "vnpay", "create-url"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000000,\n  \"currency\": \"VND\",\n  \"purpose\": \"auction_deposit\",\n  \"description\": \"Deposit with saved card\",\n  \"auctionId\": \"{{auctionId}}\",\n  \"paymentMethodId\": \"{{methodId}}\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Token payment URL created', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "9.6 Create Payment URL (pay & save)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/vnpay/create-url", "host": ["{{baseUrl}}"], "path": ["api", "payments", "vnpay", "create-url"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000000,\n  \"currency\": \"VND\",\n  \"purpose\": \"auction_deposit\",\n  \"description\": \"Deposit and save card\",\n  \"auctionId\": \"{{auctionId}}\",\n  \"saveCard\": true\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Pay & save URL created', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "C. Payment Methods",
      "item": [
        {
          "name": "9.7 Get Payment Methods",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/payments/methods", "host": ["{{baseUrl}}"], "path": ["api", "payments", "methods"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "if (res.items && res.items.length > 0) pm.collectionVariables.set('methodId', res.items[0].id);", "pm.test('Payment methods retrieved', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "9.8 Set Default",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/payments/methods/{{methodId}}/default", "host": ["{{baseUrl}}"], "path": ["api", "payments", "methods", "{{methodId}}", "default"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Default method set', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "9.9 Delete Payment Method",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/payments/methods/{{methodId}}", "host": ["{{baseUrl}}"], "path": ["api", "payments", "methods", "{{methodId}}"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Payment method deleted', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "D. Checkout",
      "item": [
        {
          "name": "9.10 Checkout (VNPay)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/checkout", "host": ["{{baseUrl}}"], "path": ["api", "payments", "checkout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"paymentMethod\": \"vnpay\",\n  \"bankCode\": \"NCB\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "console.log('Payment URL:', res.paymentUrl);", "pm.test('Checkout VNPay initiated', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "9.11 Checkout (Wallet)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/checkout", "host": ["{{baseUrl}}"], "path": ["api", "payments", "checkout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"paymentMethod\": \"wallet\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Checkout Wallet completed', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "9.12 Checkout (Hybrid)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{buyerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/checkout", "host": ["{{baseUrl}}"], "path": ["api", "payments", "checkout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"paymentMethod\": \"wallet_vnpay\",\n  \"bankCode\": \"NCB\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "console.log('Hybrid payment URL:', res.paymentUrl);", "pm.test('Checkout Hybrid initiated', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "E. Admin",
      "item": [
        {
          "name": "9.13 Refund VNPay",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/vnpay/refund", "host": ["{{baseUrl}}"], "path": ["api", "payments", "vnpay", "refund"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalTransactionRef\": \"TXN_REF_HERE\",\n  \"originalVnPayTransactionNo\": \"VNPAY_TXN_NO_HERE\",\n  \"amount\": 5000000,\n  \"reason\": \"Auction cancelled, refund deposit\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Refund processed', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    }
  ]
}
