{
  "info": {
    "name": "Flow 02: User Profile Management",
    "description": "User profile, addresses, phone verification, notification preferences, password change, login history, sessions.\n\n**Actors**: Authenticated User\n**Prerequisite**: Flow 01 (registered + logged in)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "addressId", "value": "" },
    { "key": "phoneVerificationCode", "value": "" }
  ],
  "item": [
    {
      "name": "01. Get Current User",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Get current user success', () => pm.response.to.have.status(200));",
              "const res = pm.response.json();",
              "if (res.id) console.log('Current user:', res.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Get Profile",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me", "profile"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Get profile success', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Update Profile",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me", "profile"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Nguyen\",\n  \"lastName\": \"Van A\",\n  \"displayName\": \"NguyenVanA\",\n  \"avatarMediaUploadId\": null,\n  \"dateOfBirth\": \"1995-01-15\",\n  \"gender\": \"Male\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Profile updated', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04. Set Phone Number",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me/phone",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me", "phone"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phoneNumber\": \"+84901234567\",\n  \"countryCode\": \"VN\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Phone number set', () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05. Confirm Phone Number",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me/phone/confirm",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me", "phone", "confirm"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"verificationCode\": \"{{phoneVerificationCode}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Phone confirmed', () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06. Get Addresses",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me/addresses",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me", "addresses"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Get addresses success', () => pm.response.to.have.status(200));",
              "const res = pm.response.json();",
              "if (Array.isArray(res) && res.length > 0) {",
              "  pm.collectionVariables.set('addressId', res[0].id);",
              "  console.log('First addressId saved:', res[0].id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "07. Add Address",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me/addresses",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me", "addresses"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"Home\",\n  \"recipientName\": \"Nguyen Van A\",\n  \"street\": \"123 Nguyen Hue\",\n  \"ward\": \"Ben Nghe\",\n  \"district\": \"Quan 1\",\n  \"city\": \"Ho Chi Minh\",\n  \"postalCode\": \"70000\",\n  \"phoneNumber\": \"+84901234567\",\n  \"countryCode\": \"VN\",\n  \"isDefault\": true\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Address added', () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "const res = pm.response.json();",
              "if (res.id) {",
              "  pm.collectionVariables.set('addressId', res.id);",
              "  console.log('addressId saved:', res.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "08. Update Address",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me/addresses/{{addressId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me", "addresses", "{{addressId}}"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"Office\",\n  \"recipientName\": \"Nguyen Van A\",\n  \"street\": \"456 Le Loi\",\n  \"ward\": \"Ben Thanh\",\n  \"district\": \"Quan 1\",\n  \"city\": \"Ho Chi Minh\",\n  \"phoneNumber\": \"+84901234567\",\n  \"countryCode\": \"VN\",\n  \"postalCode\": \"70000\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Address updated', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09. Set Default Address",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me/addresses/{{addressId}}/default",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me", "addresses", "{{addressId}}", "default"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Default address set', () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Remove Address",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me/addresses/{{addressId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me", "addresses", "{{addressId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Address removed', () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Get Notification Preferences",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me/notification-preferences",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me", "notification-preferences"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Get notification prefs success', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Update Notification Preferences",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me/notification-preferences",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me", "notification-preferences"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isEnabled\": true,\n  \"channels\": \"Email,Push\",\n  \"quietHours\": \"22:00-07:00\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Notification prefs updated', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Change Password",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me/password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me", "password"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"Test@1234\",\n  \"newPassword\": \"NewTest@1234\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Password changed', () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Get Login History",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me/login-history",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me", "login-history"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login history retrieved', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "15. Get Active Sessions",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me/sessions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "me", "sessions"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Sessions retrieved', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
