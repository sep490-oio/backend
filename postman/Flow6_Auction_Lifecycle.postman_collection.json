  "item": [
    {
      "name": "01 — Create & View",
      "item": [
        {
          "name": "Create Auction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auctions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Vintage Watch Auction\",\n  \"condition\": \"very_good\",\n  \"description\": \"A rare vintage watch\",\n  \"quantity\": 1,\n  \"startingPrice\": 100000,\n  \"bidIncrement\": 10000,\n  \"currency\": \"VND\",\n  \"auctionType\": \"regular\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.environment.set('auctionId', json.id);",
                  "if (json.itemId) {",
                  "    pm.environment.set('itemId', json.itemId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Auction by ID (Public)",
          "request": {
            "method": "GET",
            "header": [],
