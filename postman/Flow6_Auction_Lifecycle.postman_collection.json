    {
      "name": "04a — Platform Verify Path",
      "item": [
        {
          "name": "Create Auction for Platform Verify",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/auctions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auctions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Platform Verify Watch\",\n  \"condition\": \"good\",\n  \"description\": \"A watch requiring platform verification\",\n  \"quantity\": 1,\n  \"startingPrice\": 200000,\n  \"bidIncrement\": 20000,\n  \"currency\": \"VND\",\n  \"auctionType\": \"regular\"\n}"
            },
            "description": "Create new item+auction for platform verify path."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('secondAuctionId', json.id);",
                  "if (json.itemId) {",
                  "    pm.environment.set('itemId', json.itemId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit Item for Platform Verify",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/items/{{itemId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items", "{{itemId}}", "submit"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verifyByPlatform\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Shipping for Inspection",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/items/{{itemId}}/shipping",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items", "{{itemId}}", "shipping"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderName\": \"Test Seller\",\n  \"senderPhone\": \"0912345678\",\n  \"senderAddress\": \"123 Le Loi\",\n  \"senderWard\": \"Ben Thanh\",\n  \"senderDistrict\": \"Quan 1\",\n  \"senderProvince\": \"Ho Chi Minh\",\n  \"weightGrams\": 500,\n  \"insuranceValue\": 1000000\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('shipmentId', json.id || json.shipmentId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Upload Signature (Inspection)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/media/upload-signature",
              "host": ["{{baseUrl}}"],
              "path": ["api", "media", "upload-signature"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": \"warehouse_inspection_image\",\n  \"fileName\": \"inspection.jpg\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('cloudinarySignature', json.signature);",
                  "pm.collectionVariables.set('cloudinaryTimestamp', json.timestamp);",
                  "pm.collectionVariables.set('cloudinaryApiKey', json.apiKey);",
                  "pm.collectionVariables.set('cloudinaryPublicId', json.publicId);",
                  "pm.collectionVariables.set('cloudinaryFolder', json.folder);",
                  "pm.collectionVariables.set('uploadUrl', json.uploadUrl);"
                ]
              }
            }
          ]
        },
        {
          "name": "Upload to Cloudinary (Manual)",
          "request": {
            "method": "POST",
            "header": [],
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{uploadUrl}}",
              "host": ["{{uploadUrl}}"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                { "key": "signature", "value": "{{cloudinarySignature}}", "type": "text" },
                { "key": "timestamp", "value": "{{cloudinaryTimestamp}}", "type": "text" },
                { "key": "api_key", "value": "{{cloudinaryApiKey}}", "type": "text" },
                { "key": "public_id", "value": "{{cloudinaryPublicId}}", "type": "text" },
                { "key": "folder", "value": "{{cloudinaryFolder}}", "type": "text" }
              ]
            },
            "description": "Manual: upload inspection photo to Cloudinary. Select a file in the 'file' field before sending."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
