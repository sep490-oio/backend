                  "pm.collectionVariables.set('confirmedSecureUrl', json.secure_url);"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm Media Upload (Inspection)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "auth": {
