            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"publicId\": \"{{cloudinaryPublicId}}\",\n  \"secureUrl\": \"{{confirmedSecureUrl}}\",\n  \"resourceType\": \"image\",\n  \"format\": \"jpg\",\n  \"width\": 1024,\n  \"height\": 768,\n  \"bytes\": 102400\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
