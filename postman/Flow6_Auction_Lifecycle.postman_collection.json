{
  "info": {
    "name": "Flow 6 — Auction Lifecycle",
    "_postman_id": "flow6-auction-lifecycle",
    "description": "End-to-end auction lifecycle: create, update, submit, review, publish, platform verify, cancel, close, relist, runner-up, admin ops, shipping, and sealed bids.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "secondAuctionId", "value": "" },
    { "key": "emergencyId", "value": "" },
    { "key": "sealedBidId", "value": "" },
    { "key": "runnerUpOfferId", "value": "" },
    { "key": "inspectionUploadId", "value": "" },
    { "key": "shipmentId", "value": "" }
